@model WebsiteContentEditorModel
<div class="website-content-notice" role="status"><strong>Editing a draft</strong> Changes appear publicly only after publication. @if (ViewData["DemoPersistentText"] is true) { <text>Save text before saving an image; each save updates the draft revision.</text> } else if (ViewData["DraftImages"] != null) { <text>Add or replace photos below, after saving your text.</text> } else { <text>Website image editing is not available in this mode.</text> }</div>
@if (!ViewData.ModelState.IsValid) { <div asp-validation-summary="All" class="alert error" role="alert"></div> }
<form asp-action="SaveForm" method="post" class="website-content-editor">
    <input asp-for="DraftId" type="hidden" /><input asp-for="Revision" type="hidden" />
    <div class="website-content-grid">
        <section class="website-content-card"><h2>Hero</h2><label>Headline<input asp-for="HeroHeadline" maxlength="160" /></label><label>Description<textarea asp-for="HeroDescription" rows="3" maxlength="1000"></textarea></label></section>
        <section class="website-content-card"><h2>About Me</h2><label>Heading<input asp-for="AboutHeading" maxlength="160" /></label><label>Biography<textarea asp-for="AboutBiography" rows="4" maxlength="5000"></textarea></label></section>
        <section class="website-content-card"><h2>Home service &amp; contact</h2><label>Home-service description<textarea asp-for="HomeServiceDescription" rows="3" maxlength="2000"></textarea></label><label>Service areas<textarea asp-for="ServiceAreaInformation" rows="2" maxlength="1000"></textarea></label><label>Contact details<textarea asp-for="ContactDetails" rows="3" maxlength="2000"></textarea></label></section>
        <section class="website-content-card"><h2>Gallery photos</h2><p>@(ViewData["DraftImages"] != null ? "Add and remove gallery photos below. Photos appear in the order they were added." : "Gallery photos are managed separately where available. Gallery ordering through this editor is not available.")</p></section>
        <section class="website-content-card"><h2>Social links</h2><p>Up to 10 HTTPS links. Leave unused rows blank.</p>@for (var i = 0; i < Math.Min(Model.Links.Count, 10); i++) { <div class="website-content-row"><label>Label @(i + 1)<input asp-for="Links[i].Label" maxlength="100" /></label><label>HTTPS link @(i + 1)<input asp-for="Links[i].Url" type="url" maxlength="2048" /></label></div> }</section>
        <section class="website-content-card"><h2>Frequently asked questions</h2><p>Up to 15 questions and answers. Leave unused rows blank.</p>@for (var i = 0; i < Math.Min(Model.Faqs.Count, 15); i++) { <div class="website-content-row"><label>Question @(i + 1)<input asp-for="Faqs[i].Question" maxlength="300" /></label><label>Answer @(i + 1)<textarea asp-for="Faqs[i].Answer" rows="2" maxlength="3000"></textarea></label></div> }</section>
    </div>
    <div class="website-content-actions"><button class="button" type="submit">Save draft</button><a class="public-button outline" asp-action="Preview">Preview saved draft</a></div>
</form>
<form asp-action="PublishForm" method="post" class="website-content-publish"><input type="hidden" name="draftId" value="@Model.DraftId" /><input type="hidden" name="revision" value="@Model.Revision" /><p>Publish the saved draft. Unsaved edits above are not included.</p><button class="button" type="submit">Publish saved draft</button></form>
@if (ViewData["DemoPersistentText"] is true) { <form asp-action="DiscardDemoDraft" method="post"><input type="hidden" name="draftId" value="@Model.DraftId" /><input type="hidden" name="revision" value="@Model.Revision" /><button class="button secondary" type="submit">Discard saved draft</button></form> }
