@model List<Booking>
@{ ViewData["Title"] = "My appointments"; var notifications = (List<Notification>)ViewBag.Notifications; var payments = (List<Payment>)ViewBag.Payments; }
<div class="page-heading"><div><div class="eyebrow">MY APPOINTMENTS</div><h1>My appointments</h1><p>View and manage your home-service bookings.</p></div><a asp-controller="Bookings" asp-action="Create" class="button">Book a new look <span>＋</span></a></div>
<div class="stats"><div class="stat"><span>UPCOMING MOMENTS</span><strong>@Model.Count(b => b.Status == "Confirmed" && b.Start > DataStore.Now)</strong><small>Confirmed appointments</small></div><div class="stat"><span>PENDING PAYMENT</span><strong>@Model.Count(b => b.Status == "Pending Payment")</strong><small>Payment review or correction is pending</small></div><div class="stat"><span>BEAUTIFUL MEMORIES</span><strong>@Model.Count(b => b.Status == "Completed")</strong><small>Completed appointments</small></div></div>
<section class="panel"><div class="section-title compact"><h3>Your home-service appointments</h3><span>@Model.Count total</span></div>
<div class="customer-appointment-filters" data-customer-filters hidden aria-label="Filter appointments"><button type="button" data-filter="all" aria-pressed="true">All (@Model.Count)</button><button type="button" data-filter="upcoming" aria-pressed="false">Upcoming (@Model.Count(b => b.Start >= DataStore.Now && b.Status is "Confirmed" or "Pending Payment"))</button><button type="button" data-filter="completed" aria-pressed="false">Completed (@Model.Count(b => b.Status == "Completed"))</button><button type="button" data-filter="cancelled" aria-pressed="false">Cancelled (@Model.Count(b => b.Status is "Cancelled" or "Rejected"))</button></div><p class="customer-filter-count" data-customer-filter-count aria-live="polite"></p>
@if (!Model.Any()) { <div class="empty"><span>✧</span><h3>Your next glow is waiting.</h3><p>Choose a look and book your first appointment.</p><a asp-controller="Bookings" asp-action="Create" class="button">Explore your options ↗</a></div> }
else { <div class="appointment-list">@foreach (var b in Model) { var filter = b.Status == "Completed" ? "completed" : b.Status is "Cancelled" or "Rejected" or "Expired" ? "cancelled" : b.Start >= DataStore.Now && b.Status is "Confirmed" or "Pending Payment" ? "upcoming" : "other"; <article class="appointment-card" data-customer-appointment="@filter">
    <div class="appointment-date"><small>@b.Start.ToString("MMM")</small><strong>@b.Start.ToString("dd")</strong></div>
    <div class="appointment-copy"><h3>@(b.MixedPeople.Count > 0 ? $"Mixed-service group · {b.People} {(b.People == 1 ? "person" : "people")}" : b.Service.Name)</h3><small>@b.Reference</small><p>@b.Start.ToString("MMM dd, yyyy") · @b.Start.ToString("h:mm tt") – @b.End.ToString("h:mm tt")</p><p>@b.Area</p><small>Payment: @(b.Status == "Pending Payment" && payments.Any(p => p.BookingId == b.Id && p.ReviewStatus == "Correction Requested") ? "Correction requested" : b.PaymentStatus)</small>@if (b.RequestedStart != null) { <small>Reschedule requested</small> }</div>
    <div class="appointment-status"><strong>₱@b.Total.ToString("N2")</strong><span class="badge @b.Status.ToLowerInvariant()">@b.Status</span><a asp-controller="Bookings" asp-action="Details" asp-route-id="@b.Id" class="button secondary">View details</a></div>
</article> }</div> }</section>
@if (notifications.Any()) { <section class="panel notifications"><div class="eyebrow">BOOKING UPDATES</div>@foreach (var n in notifications) { <div><span>✧</span><p>@n.Message<small>@n.Created.ToString("MMM d, h:mm tt")</small></p></div> }</section> }
