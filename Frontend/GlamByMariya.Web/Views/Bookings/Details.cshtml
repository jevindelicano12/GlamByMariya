@model Booking
@{ ViewData["Title"] = Model.Reference; decimal paid = ViewBag.Paid; var payments = (List<Payment>)ViewBag.Payments; }
<link rel="stylesheet" href="~/css/mixed-payment.css" asp-append-version="true" />
@if (Model.MixedPeople.Count > 0) { <link rel="stylesheet" href="~/css/admin-mixed-booking.css" asp-append-version="true" /> }
<a class="subtle-link" asp-controller="Bookings" asp-action="Index">← All appointments</a><div class="page-heading"><div><div class="eyebrow">@Model.Reference</div><h1>@(Model.MixedPeople.Count > 0 ? "Mixed-service group" : Model.Service.Name)</h1><p>@Model.Start.ToString("dddd, MMMM d, yyyy · h:mm tt")</p></div><span class="badge @Model.Status.ToLowerInvariant()">@Model.Status</span></div>
@if (Model.StaffCancelledAt.HasValue) { <section class="panel stack" role="status"><h2>Appointment cancelled</h2><p>Glam by Mariya has cancelled this appointment. Mariya will contact you about verified payments and any applicable refund. Refund arrangements are handled personally.</p><p>Reason: @Model.StaffCancellationReason</p></section> }
@if (Model.CompletedAt.HasValue) { <section class="panel stack" role="status"><h2>Appointment completed</h2><p>Your appointment was marked completed by Glam by Mariya. Payment status is recorded separately.</p></section> }
@if (Model.ApprovedReschedules.LastOrDefault() is { } approved) { var q = approved.Quote; <section class="panel stack"><h2>Rescheduling approved</h2><p>Your rescheduling request has been approved. If your updated appointment has additional charges or payment differences, please coordinate directly with Glam by Mariya for payment or refund arrangements.</p><p>Previous total: ₱@q.CurrentTotal.ToString("N2") · Updated total: ₱@q.ProposedTotal.ToString("N2") · Difference: @((q.ProposedTotal - q.CurrentTotal) >= 0 ? "+" : "−")₱@Math.Abs(q.ProposedTotal - q.CurrentTotal).ToString("N2")</p></section> }
<partial name="_MixedPeople" model="Model" />
@if (Model.Status == "Pending Payment" && payments.Any(p => p.ReviewStatus == "Correction Requested")) {
    <section class="payment-correction-notice" role="status" aria-label="Payment review status">
        <strong>Payment correction requested</strong>
        <p>Check the artist’s instructions and update your payment proof. Your appointment is still pending.</p>
    </section>
}
@if (Model.MixedSubmission != null) {
<section class="panel stack"><h3>Submitted payment claim</h3><p>₱@Model.MixedSubmission.ClaimedAmount.ToString("N2") · @Model.MixedSubmission.Method · @Model.MixedSubmission.Reference</p><p>@(payments.All(p => !p.Verified) ? "Unverified — awaiting Admin review" : Model.PaymentStatus). An uploaded screenshot does not confirm payment or the appointment. Travel feasibility has not been verified.</p>
@foreach (var payment in payments) { <a class="subtle-link" asp-action="Proof" asp-route-id="@payment.Id" target="_blank" rel="noopener">View private payment proof</a> }
</section> }
<partial name="_BookingPriceDetails" model="Model" />
<div class="two-column"><section class="panel stack"><h3>Your Home-Service Appointment</h3><div class="detail-row"><span>Customer Service Address</span><strong>@Model.Address, @Model.Area</strong></div><div class="detail-row"><span>Session</span><strong>@Model.Start.ToString("h:mm tt") – @Model.End.ToString("h:mm tt")</strong></div>@foreach (var a in Model.AddOns) { <div class="detail-row"><span>@a.Name × @a.Quantity</span><strong>₱@((a.Price * a.Quantity).ToString("N2"))</strong></div> }<div class="detail-row"><span>Total (excluding travel)</span><strong>₱@Model.Total.ToString("N2")</strong></div><div class="detail-row"><span>Verified amount paid</span><strong>₱@paid.ToString("N2")</strong></div><div class="detail-row"><span>Remaining balance</span><strong>₱@Math.Max(0, Model.Total - paid).ToString("N2")</strong></div>@if (!string.IsNullOrEmpty(Model.Note)) { <div class="notice">Artist note: @Model.Note</div> }@if (Model.RequestedStart != null) { <div class="notice">Requested new time: @Model.RequestedStart.Value.ToString("MMM d, yyyy h:mm tt"). Your original slot stays reserved until approval.</div> }@if (!Model.StaffCancelledAt.HasValue && (Model.Status is "Cancelled" or "Rejected")) { <div class="notice">Cancellation deduction: ₱@Model.CancellationFee.ToString("N2")<br />Refund due: ₱@Model.RefundDue.ToString("N2") · Refunded: ₱@Model.Refunded.ToString("N2")<br />Refund reference: @Model.RefundReference</div> }<h4>Payment submissions</h4>@foreach (var p in payments) { <div class="detail-row"><span>@p.Method · @p.Reference</span><strong>₱@p.Amount.ToString("N2")<small>@(p.Verified ? "Verified" : Model.Status == "Pending Payment" && p.ReviewStatus == "Correction Requested" ? "Correction requested" : "Awaiting verification")</small></strong></div> }</section>
<div class="stack">@if (Model.Status == "Confirmed" && Model.Start > DataStore.Now) {
    <section class="panel"><h3>Need another moment?</h3><p>Request a new time. Your existing appointment and booked prices stay unchanged until the artist approves.</p>
        <form asp-action="Reschedule" method="post" class="stack">
            <input type="hidden" name="id" value="@Model.Id" />
            @{ ViewData["AvailabilityBookingId"] = Model.Id; }
            <partial name="_AvailabilityCalendar" />
            <button type="submit" class="button secondary">Review updated total ↗</button>
        </form>
    </section>
    <section class="panel"><h3>Cancel your appointment</h3><p>Verified paid: <strong>₱@paid.ToString("N2")</strong><br />Cancellation deduction: <strong>₱200.00</strong><br />Refund due: <strong>₱@Math.Max(0, paid - 200).ToString("N2")</strong></p><form asp-action="Cancel" method="post" class="stack"><input type="hidden" name="id" value="@Model.Id" />@if (Model.MixedPeople.Count > 0) { <label>Cancellation reason<textarea name="reason" required maxlength="1000" rows="2"></textarea></label> }<label class="check-label"><input type="checkbox" name="confirmed" value="true" required /> I confirm cancellation and the ₱200 deduction.</label><button class="button danger">Cancel appointment</button></form></section>
}
@if (Model.Status == "Pending Payment" && payments.Any(p => !p.Verified)) { <section class="panel"><h3>Update payment proof</h3><p>Correct your reference or provide a clearer screenshot for the artist to review.</p><form asp-action="CorrectProof" method="post" enctype="multipart/form-data" class="stack"><input type="hidden" name="id" value="@Model.Id" />@if (payments.FirstOrDefault() is { } payment) { @if (DataStore.IsPersistent) { <input type="hidden" name="expectedPaymentRevision" value="@payment.PersistentReviewRevision" /><input type="hidden" name="expectedPaymentVersion" value="@payment.PersistentReviewVersion" /> } else { <input type="hidden" name="paymentRevision" value="@payment.Revision" /> } }<label>Payment reference<input name="reference" required maxlength="150" /></label><label>New screenshot<input type="file" name="proof" accept="image/jpeg,image/png" /></label><button class="button secondary">Submit correction ↗</button></form></section> }
@if (Model.Status == "Pending Payment" && Model.Start > DataStore.Now && Model.MixedPeople.Count == 0) { <section class="panel"><h3>Cancel this request</h3><p>Your booking hasn't been accepted yet, so there is <strong>no cancellation fee</strong>. If you already sent a payment, the artist will return it.</p><form asp-action="Cancel" method="post" class="stack"><input type="hidden" name="id" value="@Model.Id" /><label>Reason (optional)<select name="reason"><option value="">Choose a reason</option><option>Change of plans</option><option>Booked the wrong date or time</option><option>Found another option</option><option>Other</option></select></label><label class="check-label"><input type="checkbox" name="confirmed" value="true" required /> I want to cancel this booking request.</label><button class="button danger">Cancel request</button></form></section> }</div></div>
<partial name="_BookingHistory" model="Model" />
