@inject GlamByMariya.Infrastructure.Services.EmailVerificationService EmailCodes
@{ var register = ViewContext.RouteData.Values["action"]?.ToString() == "Register"; var selectedGender = ViewBag.Gender as string; ViewData["Title"] = register ? "Join Glam by Mariya" : "Welcome back"; }
<div class="auth-wrap @(register ? "auth-register" : null)"><div class="eyebrow">YOUR BEAUTY SPACE</div><h1>@(register ? "A beautiful beginning." : "Welcome back.")</h1><p>@(register ? "Choose an 8–128 character password with an English letter (A–Z) and a number (0–9). Symbols and other characters are allowed; some, such as emoji, count as two." : "Your next little moment of luxury starts here.")</p><section class="panel">
@if (ViewBag.Error != null) { <div class="alert error auth-alert" role="alert">@ViewBag.Error</div> }
@if (register && !EmailCodes.CanSendRegistrationCode) { <div class="auth-notice" role="status"><span class="auth-notice-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10.5v5.5"/><path d="M12 7.5h.01"/></svg></span><div><strong>Registration is paused</strong><p>Email verification is not configured in this environment. New customer registration is unavailable; no email will be sent.</p><p class="auth-notice-hint">Existing customers can still sign in below.</p></div></div> }
<form asp-action="@(register ? "Register" : "Login")" method="post" class="stack" id="auth-form" data-register="@(register ? "true" : "false")">
<input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
@if (register) {
<div class="form-grid name-grid"><label>First name<input name="firstName" required maxlength="50" autocomplete="given-name" /><small class="field-error" data-error-for="firstName" hidden></small></label><label>Last name<input name="lastName" required maxlength="50" autocomplete="family-name" /><small class="field-error" data-error-for="lastName" hidden></small></label><label>Suffix (optional)<select name="suffix"><option value="">None</option><option>Jr.</option><option>Sr.</option><option>II</option><option>III</option><option>IV</option></select></label></div>
<div class="form-grid"><label>Birthday<input name="birthday" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" autocomplete="bday" required /><small class="field-error" data-error-for="birthday" hidden></small></label><label>Gender<select name="gender" required aria-describedby="gender-error"><option value="" disabled selected="@(selectedGender == null || !GlamByMariya.Core.BusinessRules.RegistrationRules.Genders.Contains(selectedGender))">Select gender</option><option value="Male" selected="@(selectedGender == "Male")">Male</option><option value="Female" selected="@(selectedGender == "Female")">Female</option><option value="Others" selected="@(selectedGender == "Others")">Others</option></select><small id="gender-error" class="field-error" data-error-for="gender" aria-live="polite" hidden></small></label></div>
<label>Address<textarea name="address" required minlength="8" maxlength="500" rows="2" autocomplete="street-address" placeholder="House / unit number, street, barangay"></textarea><small class="field-error" data-error-for="address" hidden></small></label>
}
<label>Email address<input name="email" type="email" required autocomplete="email" /><small class="field-error" data-error-for="email" hidden></small></label><label>Password<span class="password-field"><input name="password" id="password" type="password" required minlength="@(register ? "8" : null)" maxlength="@(register ? "128" : null)" autocomplete="@(register ? "new-password" : "current-password")" /><button type="button" class="password-toggle" data-password-toggle="password" aria-label="Show password" aria-pressed="false" title="Show password"><svg class="eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg><svg class="eye-closed is-hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49"/><path d="M14.084 14.158a3 3 0 0 1-4.242-4.242"/><path d="M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143"/><path d="m2 2 20 20"/></svg></button></span><small class="field-error" data-error-for="password" hidden></small></label>@if (register) { <label class="check-label terms-agree"><input type="checkbox" name="acceptTerms" value="true" required /> <span>I have read and agree to the <a asp-controller="Home" asp-action="Terms" target="_blank" rel="noopener">Terms and Conditions</a>, including the down payment, cancellation and transportation rules.</span></label> }<button class="button">@(register ? "Create account" : "Sign in") <span>↗</span></button>
</form>@if (!register) { <p class="auth-switch"><a asp-action="ForgotPassword">Forgot password?</a></p> }<p class="auth-switch">@(register ? "Already have an account?" : "New to Glam by Mariya?") <a asp-action="@(register ? "Login" : "Register")" asp-route-returnUrl="@ViewBag.ReturnUrl">@(register ? "Sign in" : "Create an account")</a></p></section></div>
@section Scripts {
@{ var cspNonce = Context.Items["csp-nonce"] as string; }
<script src="~/js/vendor/zod-3.23.8/index.umd.min.js" asp-append-version="true"></script>
<script nonce="@cspNonce">
(() => {
  const form = document.querySelector('#auth-form');
  if (!form || form.dataset.register !== 'true' || !window.Zod) return;
  const { z } = window.Zod;
  const nameRule = (label) => z.string().trim().min(1, `${label} is required.`).max(50, `${label} must be 50 characters or fewer.`).regex(/^[\p{L} '\-]+$/u, `${label} may only contain letters, spaces, hyphens and apostrophes.`);
  const schema = z.object({
    firstName: nameRule('First name'),
    lastName: nameRule('Last name'),
    email: z.string().trim().min(1, 'Email is required.').email('Enter a valid email address.').max(254, 'Email is too long.'),
    birthday: z.string().min(1, 'Enter your birthday.'),
    gender: z.string({ required_error: 'Select a gender.' }).min(1, 'Select a gender.').refine(value => ['Male', 'Female', 'Others'].includes(value), 'Choose a valid option for gender.'),
    address: z.string().trim().min(8, 'Address must be at least 8 characters.').max(500, 'Address must be 500 characters or fewer.'),
    password: z.string().min(8, 'Password must be at least 8 characters.').max(128, 'Password must be 128 characters or fewer.').regex(/[A-Za-z]/, 'Include an English letter (A–Z).').regex(/[0-9]/, 'Include a number (0–9).')
  });
  const errors = (name, message) => {
    const slot = form.querySelector(`[data-error-for="${name}"]`);
    const field = form.querySelector(`[name="${name}"]`);
    if (slot) { slot.textContent = message || ''; slot.hidden = !message; }
    if (!field) return;
    if (message) {
      if (slot && !slot.id) slot.id = `error-${name}`;
      const base = field.dataset.baseDescribedby ?? field.getAttribute('aria-describedby') ?? '';
      field.dataset.baseDescribedby = base;
      field.setAttribute('aria-describedby', [base, slot?.id].filter(Boolean).join(' '));
      field.setAttribute('aria-invalid', 'true');
    } else {
      field.removeAttribute('aria-invalid');
      const base = field.dataset.baseDescribedby ?? '';
      if (base) field.setAttribute('aria-describedby', base); else field.removeAttribute('aria-describedby');
    }
  };
  form.addEventListener('submit', (event) => {
    form.querySelectorAll('[data-error-for]').forEach((slot) => { slot.hidden = true; });
    const result = schema.safeParse(Object.fromEntries(new FormData(form)));
    if (result.success) return;
    event.preventDefault();
    const shown = new Set();
    for (const issue of result.error.issues) {
      const field = String(issue.path[0] ?? '');
      if (field && !shown.has(field)) { shown.add(field); errors(field, issue.message); }
    }
    const first = form.querySelector('[data-error-for]:not([hidden])')?.closest('label')?.querySelector('input, select, textarea');
    first?.focus();
  });
  form.addEventListener('input', (event) => {
    if (event.target.name) errors(event.target.name, '');
  });
})();
</script>
}
