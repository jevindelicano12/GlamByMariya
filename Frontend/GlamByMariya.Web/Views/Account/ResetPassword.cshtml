@{ ViewData["Title"] = "Set a new password"; }
<div class="auth-wrap"><div class="eyebrow">ACCOUNT RECOVERY</div><h1>Choose a new password.</h1><p>Enter the 6-digit reset code sent to <strong>@ViewBag.Email</strong>, plus a password of 8–128 characters including an English letter (A–Z) and a number (0–9). Symbols and other characters are allowed; some, such as emoji, count as two.</p><section class="panel">
@if (ViewBag.Notice != null) { <div class="alert success">@ViewBag.Notice</div> }
@if (ViewBag.Error != null) { <div class="alert error">@ViewBag.Error</div> }
<form asp-action="ResetPassword" method="post" class="stack">
<input type="hidden" name="email" value="@ViewBag.Email" />
<label>6-digit code<input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="one-time-code" placeholder="123456" /></label>
<label>New password<input name="newPassword" type="password" required minlength="8" maxlength="128" autocomplete="new-password" /></label>
<label>Confirm new password<input name="confirmPassword" type="password" required minlength="8" maxlength="128" autocomplete="new-password" /></label>
<button class="button">Update password <span>↗</span></button>
</form></section></div>
