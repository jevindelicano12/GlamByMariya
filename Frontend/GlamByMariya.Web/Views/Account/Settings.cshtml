@model GlamByMariya.Core.Entities.AccountSettingsPage
@{ ViewData["Title"] = "My profile & account settings"; var verified = Model.Preferences.VerifiedAt.HasValue && Model.Preferences.VerifiedEmail.Equals(Model.User.Email, StringComparison.OrdinalIgnoreCase); }
<div class="settings-page">
<div class="page-heading"><div><div class="eyebrow">YOUR BEAUTY SPACE</div><h1>My profile</h1><p>Your personal details, password &amp; security, and preferences.</p></div></div>
<div class="settings-grid">
<div class="settings-col">
<section class="panel settings-card" aria-labelledby="profile-title">
    <div class="profile-avatar-row">
        <div class="profile-photo">@if (Model.Preferences.AvatarUrl != null) { <img src="@Model.Preferences.AvatarUrl" alt="Your profile picture" width="64" height="64" /> } else { <span aria-label="Default profile picture">@(Model.User.Name.Length > 0 ? Model.User.Name[..1] : "L")</span> }</div>
        <div class="profile-avatar-controls">
            <form asp-action="UploadAvatar" method="post" enctype="multipart/form-data" class="profile-avatar-form">
                <div class="profile-avatar-head">
                    <label for="avatar-file">Profile picture</label>
                    <small>JPG or PNG, up to 2 MB.</small>
                </div>
                <div class="profile-upload-inline">
                    <input id="avatar-file" type="file" name="avatar" accept="image/jpeg,image/png" required />
                    <button class="button secondary" type="submit">Upload</button>
                </div>
            </form>
            @if (Model.Preferences.AvatarUrl != null) { <form asp-action="RemoveAvatar" method="post"><button class="text-button" type="submit">Remove picture</button></form> }
        </div>
    </div>
    <div><div class="eyebrow">PERSONAL DETAILS</div><h2 id="profile-title">Your profile</h2><p>Keep your booking address up to date. Contact the business to request a name correction.</p></div>
    <div class="profile-email-row">
        <div><span class="profile-email-label">Email address</span><strong class="account-email">@Model.User.Email</strong></div>
        <span class="email-status @(verified ? "is-verified" : "")">@(verified ? "✓ Verified" : "Unverified")</span>
    </div>
    @if (!verified) {
        <details class="verify-inline">
            <summary>Verify email address</summary>
            <div class="stack" style="margin-top:12px">
                <form asp-action="SendEmailVerification" method="post"><button class="button secondary" type="submit">Send 6-digit verification code</button></form>
                <form asp-action="ConfirmEmail" method="post" class="stack"><label>Verification code<input class="otp-input" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required placeholder="000000" /></label><button class="button" type="submit">Verify email</button></form>
                <small>Codes expire after 15 minutes. Wait 60 seconds before resending.</small>
            </div>
        </details>
    }
    <form asp-action="SaveProfile" method="post" class="stack">
        @if (Model.User.Role == "Customer") { <div class="form-grid"><label>First name<input value="@Model.User.FirstName" readonly /></label><label>Last name<input value="@Model.User.LastName" readonly /></label></div> } else { <div class="form-grid"><label>First name<input name="firstName" value="@Model.User.FirstName" required maxlength="50" autocomplete="given-name" /></label><label>Last name<input name="lastName" value="@Model.User.LastName" required maxlength="50" autocomplete="family-name" /></label></div> }
        @if (Model.User.Role == "Customer") { <div class="form-grid"><label>Suffix<input value="@(string.IsNullOrEmpty(Model.User.Suffix) ? "Not provided" : Model.User.Suffix)" readonly /></label><label>Birthday<input value="@(Model.User.Birthday?.ToString("MMMM d, yyyy") ?? "Not provided")" readonly /></label></div> }
        <div class="form-grid">@if (Model.User.Role == "Customer" && Model.User.Birthday.HasValue) { <input type="hidden" name="age" value="@Model.User.Age" /> } else { <label>Age<input name="age" type="number" min="@GlamByMariya.Core.BusinessRules.RegistrationRules.MinimumAge" max="@GlamByMariya.Core.BusinessRules.RegistrationRules.MaximumAge" value="@Model.User.Age" required /></label> }<label>Gender<select name="gender"><option value="">Prefer not to say</option>@foreach (var gender in GlamByMariya.Core.BusinessRules.RegistrationRules.Genders) { <option value="@gender" selected="@(gender == Model.User.Gender)">@gender</option> }</select></label></div>
        <label>Address<textarea name="address" rows="3" minlength="8" maxlength="500" required autocomplete="street-address">@Model.User.Address</textarea></label>
        <button class="button" type="submit">Save profile</button>
    </form>
</section>
</div>
<div class="settings-col">
<section class="panel settings-card" aria-labelledby="password-title">
    <div><div class="eyebrow">ACCOUNT SECURITY</div><h2 id="password-title">Change password</h2><p>Update your account password to keep your bookings secure.</p></div>
    <form asp-action="ChangePassword" method="post" class="stack">
        <label>Current password<input name="currentPassword" type="password" required autocomplete="current-password" /></label>
        <label>New password<input name="newPassword" type="password" required minlength="8" maxlength="128" autocomplete="new-password" /></label>
        <label>Confirm new password<input name="confirmPassword" type="password" required minlength="8" maxlength="128" autocomplete="new-password" /></label>
        <small>Changing your password signs you out. Other sessions expire when they next access the app.</small>
        <button class="button" type="submit">Update password</button>
    </form>
    <a class="account-link" asp-action="ForgotPassword">Forgot your current password?</a>
</section>
<section class="panel settings-card settings-card-compact" aria-labelledby="notifications-title">
    <div class="compact-card-head"><div class="eyebrow">MAKE IT YOURS</div><h2 id="notifications-title">Notifications</h2></div>
    <form asp-action="SaveNotifications" method="post" class="stack">
        <label class="preference-toggle"><input name="notificationsEnabled" type="checkbox" value="true" checked="@Model.Preferences.NotificationsEnabled" /><span><strong>In-app booking notifications</strong><small>Show booking updates, payment reviews &amp; reschedule messages. Email alerts stay active automatically.</small></span></label>
        <button class="button" type="submit">Save preferences</button>
    </form>
    <div class="session-inline-row">
        <span>Signed in as <strong>@Model.User.Name</strong></span>
        <form asp-controller="Account" asp-action="Logout" method="post"><button class="button secondary" type="submit">Sign out</button></form>
    </div>
</section>
</div>
</div>
</div>
