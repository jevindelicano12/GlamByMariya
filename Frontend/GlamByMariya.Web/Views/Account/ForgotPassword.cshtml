@{ ViewData["Title"] = "Forgot password"; }
<div class="auth-wrap"><div class="eyebrow">ACCOUNT RECOVERY</div><h1>Reset your password.</h1><p>Enter your account email and we will send a 6-digit reset code.</p><section class="panel">
@if (ViewBag.Error != null) { <div class="alert error">@ViewBag.Error</div> }
<form asp-action="ForgotPassword" method="post" class="stack">
<label>Email address<input name="email" type="email" required autocomplete="email" /></label>
<button class="button">Send reset code <span>↗</span></button>
</form>
<p class="auth-switch">Remembered it? <a asp-action="Login">Sign in</a></p></section></div>
