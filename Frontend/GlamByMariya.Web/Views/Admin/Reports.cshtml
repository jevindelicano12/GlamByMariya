@model List<Booking>
@{ ViewData["Title"] = "Sales Reports"; var payments = (List<Payment>)ViewBag.Payments; var collected = payments.Where(p => p.Verified).Sum(p => p.Amount); var refunds = Model.Sum(b => b.Refunded); }
<div class="page-heading"><div><div class="eyebrow">A CLEARER PICTURE</div><h1>Sales Reports</h1><p>Recorded payments and appointment totals. Unverified claims are excluded from collections.</p></div></div>
<form method="get" class="panel"><label>Appointment date from <input type="date" name="from" value="@ViewBag.From" /></label> <label>Through <input type="date" name="to" value="@ViewBag.To" /></label> <button class="button" type="submit">Apply</button> <a asp-action="Reports">Clear</a><p>Dates filter by appointment date, not by payment or refund date.</p></form>
<div class="stats four"><div class="stat"><span>VERIFIED COLLECTIONS</span><strong class="money">₱@collected.ToString("N2")</strong><small>Before refunds</small></div><div class="stat"><span>REFUNDS SENT</span><strong class="money">₱@refunds.ToString("N2")</strong><small>Recorded transfers</small></div><div class="stat"><span>NET CASH COLLECTED</span><strong class="money">₱@((collected - refunds).ToString("N2"))</strong><small>Collections minus refunds</small></div><div class="stat"><span>COMPLETED APPOINTMENTS</span><strong>@Model.Count(b => b.Status == "Completed")</strong><small>Service value ₱@Model.Where(b => b.Status == "Completed").Sum(b => b.Total).ToString("N2")</small></div></div>
<section class="panel"><h2>Verified collections by service</h2><p>Based on recorded verified payments, not unverified screenshots.</p>@foreach (var group in Model.GroupBy(b => b.Service.Name).OrderBy(g => g.Key)) { var ids = group.Select(b => b.Id).ToHashSet(); <div class="detail-row"><strong>@group.Key</strong><span>₱@payments.Where(p => p.Verified && ids.Contains(p.BookingId)).Sum(p => p.Amount).ToString("N2")</span></div> } @if (!Model.Any()) { <p>No bookings recorded.</p> }</section>
