@model List<Booking>
@inject XenditClient Xendit
@{ ViewData["Title"] = "Payments"; var payments = (List<Payment>)ViewBag.Payments; var online = Xendit.Enabled && DataStore.IsPersistent; }
<div class="page-heading"><div><div class="eyebrow">PAYMENT MANAGEMENT</div><h1>Payments</h1><p>@(online ? "Down payments made through Xendit, and cash balances recorded when an appointment is completed. Xendit marks a down payment verified only after it goes through." : "Review submitted claims and recorded decisions. A screenshot does not confirm a transfer.")</p></div></div>
<section class="panel"><h2>Payment records</h2>
@if (!payments.Any()) { <p>No payments recorded.</p> }
@foreach (var p in payments) { var b = Model.FirstOrDefault(x => x.Id == p.BookingId); if (b == null) { continue; }
<article class="calendar-item"><div><strong>@b.CustomerName · @b.Reference · @b.ServiceDescription</strong><p>@b.BookingType · @AdminPaymentLabels.PeopleCount(b.People)</p><p>Total ₱@b.Total.ToString("N2") · Minimum ₱@b.RequiredDownPayment.ToString("N2") · @(p.Method == "Cash" ? "Cash balance" : online ? "Down payment" : "Submitted") ₱@p.Amount.ToString("N2")</p><p>@p.Method · Reference @p.Reference · @AdminPaymentLabels.Payment(p, b, online)</p><small>Verified for booking ₱@payments.Where(x => x.BookingId == b.Id && x.Verified).Sum(x => x.Amount).ToString("N2") · Remaining ₱@Math.Max(0, b.Total - payments.Where(x => x.BookingId == b.Id && x.Verified).Sum(x => x.Amount)).ToString("N2")</small><div class="payment-record-actions">@if (!DataStore.IsPersistent && (p.ProofPath != null || p.ProofKey != null)) { <a class="button secondary" asp-action="Proof" asp-route-id="@p.Id" asp-route-bookingId="@b.Id">View private proof</a> }<a class="button secondary" asp-action="Details" asp-route-id="@b.Id">Review booking and actions</a></div></div></article>
}
</section>
