@model List<Booking>
@{ ViewData["Title"] = "Payments"; var payments = (List<Payment>)ViewBag.Payments; }
<div class="page-heading"><div><div class="eyebrow">PAYMENT MANAGEMENT</div><h1>Payments</h1><p>Review submitted claims and recorded decisions. A screenshot does not confirm a transfer.</p></div></div>
<section class="panel"><h2>Payment records</h2>
@if (!payments.Any()) { <p>No payments recorded.</p> }
@foreach (var p in payments) { var b = Model.FirstOrDefault(x => x.Id == p.BookingId); if (b == null) { continue; }
<article class="calendar-item"><div><strong>@b.CustomerName · @b.Reference · @b.ServiceDescription</strong><p>@b.BookingType · @b.People people</p><p>Total ₱@b.Total.ToString("N2") · Minimum ₱@b.RequiredDownPayment.ToString("N2") · Submitted ₱@p.Amount.ToString("N2")</p><p>@p.Method · Reference @p.Reference · @(p.Verified ? "Verified" : "Unverified — awaiting review")</p><small>Verified for booking ₱@payments.Where(x => x.BookingId == b.Id && x.Verified).Sum(x => x.Amount).ToString("N2") · Remaining ₱@Math.Max(0, b.Total - payments.Where(x => x.BookingId == b.Id && x.Verified).Sum(x => x.Amount)).ToString("N2")</small><div>@if (!DataStore.IsPersistent && (p.ProofPath != null || p.ProofKey != null)) { <a asp-action="Proof" asp-route-id="@p.Id" asp-route-bookingId="@b.Id">View private proof</a><text> · </text> }<a asp-action="Details" asp-route-id="@b.Id">Review booking and actions</a></div></div></article>
}
</section>
