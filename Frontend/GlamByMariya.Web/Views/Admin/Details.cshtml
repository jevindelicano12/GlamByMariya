@model Booking
@{ ViewData["Title"] = "Review " + Model.Reference; decimal paid = ViewBag.Paid; var payments = (List<Payment>)ViewBag.Payments; }
@if (Model.MixedPeople.Count > 0) { <partial name="_MixedBookingDetails" model="Model" /> }
else {
@if (Model.Status == "Pending Payment" && payments.Any(p => p.ReviewStatus == "Correction Requested")) {
    <section class="payment-correction-notice" role="status" aria-label="Payment review status">
        <strong>Payment correction requested</strong>
        <p>Waiting for the Customer to update the payment claim.</p>
    </section>
}
<partial name="_BookingPriceDetails" model="Model" />
<a asp-controller="Admin" asp-action="Index" class="subtle-link">← Business overview</a><div class="page-heading"><div><div class="eyebrow">BOOKING REVIEW · @Model.Reference</div><h1>@Model.CustomerName</h1><p>@Model.Service.Name · @Model.Start.ToString("MMM d, yyyy h:mm tt")</p></div><span class="badge @Model.Status.ToLowerInvariant()">@Model.Status</span></div>
<div class="two-column"><section class="panel stack"><h3>Appointment & payment</h3><div class="detail-row"><span>Customer Service Address</span><strong>@Model.Address, @Model.Area</strong></div><div class="detail-row"><span>Session end</span><strong>@Model.End.ToString("h:mm tt") + preparation buffer (travel not estimated)</strong></div><div class="detail-row"><span>@Model.Service.Name</span><strong>₱@Model.Service.Price.ToString("N2")</strong></div>@foreach (var a in Model.AddOns) { <div class="detail-row"><span>@a.Name × @a.Quantity</span><strong>₱@((a.Price * a.Quantity).ToString("N2"))</strong></div> }<div class="detail-row"><span>Transportation reimbursement</span><strong>Separate actual expense</strong></div><div class="detail-row"><span>Transportation policy</span><strong>@(Model.TransportationPolicyAcknowledgedAt.HasValue ? "Acknowledged" : "Not acknowledged")</strong></div><div class="detail-row"><span>Total</span><strong>₱@Model.Total.ToString("N2")</strong></div><div class="detail-row"><span>Verified paid / remaining</span><strong>₱@paid.ToString("N2") / ₱@Math.Max(0, Model.Total - paid).ToString("N2")</strong></div>@foreach (var p in payments) { <div class="payment-box"><strong>@p.Method · ₱@p.Amount.ToString("N2")</strong><p>Reference: @p.Reference</p><span class="badge @(p.Verified ? "confirmed" : "pending")">@(p.Verified ? "Verified" : "Unverified")</span>@if (p.ProofPath != null || p.ProofKey != null) { <a class="subtle-link" asp-controller="Admin" asp-action="Proof" asp-route-id="@p.Id" asp-route-reviewRevision="@p.PersistentReviewRevision" asp-route-reviewVersion="@p.PersistentReviewVersion" target="_blank" rel="noopener">View private proof ↗</a> }@if (p.VerifiedAt != null) { <small>Verified @p.VerifiedAt.Value.ToString("MMM d, yyyy h:mm tt")</small> }</div> }@if (!string.IsNullOrEmpty(Model.Note)) { <div class="notice">@Model.Note</div> }</section>
<div class="stack">
@if (Model.Status == "Pending Payment") { <section class="panel stack"><h3>Review this down payment</h3><p>Confirm the actual transfer matches the claimed amount and meets the required minimum of ₱@Model.RequiredDownPayment.ToString("N2") (@Model.DownPaymentPercentSnapshot.ToString("N0")% of the total). Review the address and route. Verification rechecks availability and confirms the appointment in one operation.</p><form asp-action="Action" method="post"><input type="hidden" name="id" value="@Model.Id" />@if (payments.Count == 1) { <input type="hidden" name="paymentId" value="@payments[0].Id" />@if (DataStore.IsPersistent) { <input type="hidden" name="reviewRevision" value="@payments[0].PersistentReviewRevision" /><input type="hidden" name="reviewVersion" value="@payments[0].PersistentReviewVersion" /><label><input type="checkbox" name="reviewed" value="true" required /> I inspected this proof and checked the actual transfer and reference.</label> } else { <input type="hidden" name="paymentRevision" value="@payments[0].Revision" /> } }<button name="operation" value="verify" class="button full">Verify claimed payment &amp; confirm ↗</button></form><form asp-action="Action" method="post" class="stack"><input type="hidden" name="id" value="@Model.Id" /><label>Correction instructions / rejection reason<textarea name="reason" required rows="3"></textarea></label><div class="button-row"><button name="operation" value="proof" class="button secondary">Request new proof</button><button name="operation" value="reject" class="button danger">Reject</button></div></form></section> }
@if (Model.PendingReschedule is { } pending) { var q = pending.Quote; <section class="panel stack"><h3>Reschedule request</h3><p>Current @q.OriginalStart.ToString("MMM d, yyyy h:mm tt") · Proposed @q.ProposedStart.ToString("MMM d, yyyy h:mm tt")</p><p>Original ₱@q.InitialTotal.ToString("N2") · Current ₱@q.CurrentTotal.ToString("N2") · Proposed ₱@q.ProposedTotal.ToString("N2") · Difference @((q.ProposedTotal - q.CurrentTotal) >= 0 ? "+" : "−")₱@Math.Abs(q.ProposedTotal - q.CurrentTotal).ToString("N2")</p><p>Early fee ₱@q.EarlyFee.ToString("N2") · Late fee ₱@q.LateFee.ToString("N2"). Customer consented @pending.ConsentedAt.ToString("MMM d, yyyy h:mm tt"). Payment differences are arranged personally.</p>@if (User.IsInRole("SuperAdmin")) { <form asp-action="Action" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="rescheduleQuoteId" value="@q.Id" /><button name="operation" value="reschedule" class="button full">Approve new slot ↗</button></form> } else { <p>Only SuperAdmin may approve this request.</p> }<form asp-action="Action" method="post" class="stack"><input type="hidden" name="id" value="@Model.Id" /><label>Reason to decline<input name="reason" required /></label><button name="operation" value="decline" class="button secondary">Keep original slot</button></form></section> }
else if (DataStore.IsPersistent && Model.Status == "Confirmed" && Model.RequestedStart is { } requested) { <section class="panel stack"><h3>Reschedule request</h3><p>Current @Model.Start.ToString("MMM d, yyyy h:mm tt") · Proposed @requested.ToString("MMM d, yyyy h:mm tt")</p><p>The booking total stays ₱@Model.Total.ToString("N2"). The proposed time is checked again when you approve.</p>@if (User.IsInRole("SuperAdmin")) { <form asp-action="Action" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="requestedStart" value="@requested.ToString("s")" /><button name="operation" value="reschedule" class="button full">Approve new slot ↗</button></form> } else { <p>Only SuperAdmin may approve this request.</p> }<form asp-action="Action" method="post" class="stack"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="requestedStart" value="@requested.ToString("s")" /><label>Reason to decline<input name="reason" required /></label><button name="operation" value="decline" class="button secondary">Keep original slot</button></form></section> }
@if (Model.Status == "Confirmed") { <section class="panel stack"><h3>Other appointment outcomes</h3><form asp-action="Action" method="post" class="stack"><input type="hidden" name="id" value="@Model.Id" /><label>No-show / incomplete reason<input name="reason" required /></label><div class="button-row"><button name="operation" value="noshow" class="button secondary">No-show</button><button name="operation" value="incomplete" class="button secondary">Incomplete</button></div></form></section> }
<partial name="_StaffBookingActions" model="Model" />
@if (Model.RefundDue > 0) { <section class="panel stack"><h3>Manual refund record</h3><p>Fee: ₱@Model.CancellationFee.ToString("N2")<br />Refund due: ₱@Model.RefundDue.ToString("N2")<br />Already refunded: ₱@Model.Refunded.ToString("N2")</p>@if (Model.Refunded < Model.RefundDue) { <form asp-action="Action" method="post" class="stack"><input type="hidden" name="id" value="@Model.Id" /><label>Amount actually sent (₱)<input name="amount" type="number" step="0.01" min="0.01" max="@(Model.RefundDue - Model.Refunded)" required /></label><label>Refund transfer reference<input name="reference" required /></label><button name="operation" value="refund" class="button secondary">Record sent refund</button></form> }<small>This does not initiate a transfer. Send the refund manually first.</small></section> }
</div></div>
<partial name="_BookingHistory" model="Model" />
}
