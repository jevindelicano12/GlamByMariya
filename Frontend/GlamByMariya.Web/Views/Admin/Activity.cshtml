@model IReadOnlyList<GlamByMariya.Core.Entities.DemoAdminActivity>
@{ ViewData["Title"] = "Activity Logs"; var zone = TimeZoneInfo.FindSystemTimeZoneById("Asia/Manila"); }
<div class="activity-page">
<div class="page-heading"><div><div class="eyebrow">SYSTEM OWNER</div><h1>Activity Logs</h1><p>Administrative activity recorded during this Demo process.</p></div></div>
<div class="notice">Demo only: this history is held in memory and disappears on restart. It is not complete, durable or tamper-resistant. File-backed gallery and content changes can survive after these entries are lost.</div>
<form method="get" class="panel activity-filter"><label>Search actor, action or ID<input name="search" value="@ViewBag.Search" maxlength="100" placeholder="Actor, action or ID" /></label><label>Category<select name="category"><option value="">All</option>@foreach (var category in new[] { "Booking", "Service", "Add-on", "Settings", "Schedule", "Gallery", "Website Content" }) { <option value="@category" selected="@((string)ViewBag.Category == category)">@category</option> }</select></label><button class="button" type="submit">Filter</button><a asp-action="Activity">Clear</a></form>
<section class="panel activity-list"><h2>Recorded actions</h2>@if (!Model.Any()) { <p class="activity-empty">No matching activity is available.</p> }
@foreach (var entry in Model) { <div class="activity"><strong>@entry.Action</strong><p>@entry.ActorName · @entry.Role</p><small>Actor @entry.ActorId · @entry.TargetType @entry.TargetId · @TimeZoneInfo.ConvertTime(entry.OccurredAt, zone).ToString("MMM d, yyyy h:mm tt") Manila · Succeeded</small></div> }
</section>
</div>
