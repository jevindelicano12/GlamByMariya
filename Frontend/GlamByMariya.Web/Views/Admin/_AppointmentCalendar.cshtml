@model List<Booking>
@{ var month = (DateTime)ViewBag.Month; var selectedDay = (int?)ViewBag.Day; var blocks = (List<AvailabilityBlock>)ViewBag.Blocks; var settings = (BusinessSettings)ViewBag.Hours; var previous = month.AddMonths(-1); var next = month.AddMonths(1); var selectedDate = selectedDay.HasValue ? month.AddDays(selectedDay.Value - 1) : (DateTime?)null; var dayBookings = selectedDate.HasValue ? Model.Where(b => b.Start.Date == selectedDate.Value && AdminPaymentLabels.OnCalendar(b)).ToList() : new List<Booking>(); var dayBlocks = selectedDate.HasValue ? blocks.Where(b => b.From < selectedDate.Value.AddDays(1) && b.To > selectedDate.Value).ToList() : new List<AvailabilityBlock>(); var travelLines = AdminTravelLines.For(dayBookings, settings); }
<section class="panel">
    <div class="calendar-month-heading"><a asp-action="Appointments" asp-route-mode="calendar" asp-route-year="@previous.Year" asp-route-month="@previous.Month" aria-label="Previous month">← Previous</a><h2>@month.ToString("MMMM yyyy")</h2><a asp-action="Appointments" asp-route-mode="calendar" asp-route-year="@next.Year" asp-route-month="@next.Month" aria-label="Next month">Next →</a></div>
    <p>Studio hours: @settings.OpenHour:00–@settings.CloseHour:00. @(DataStore.IsPersistent ? "Unpaid bookings hold their time for 15 minutes while waiting for payment. Expired, rejected and cancelled bookings are not shown here." : "Pending and confirmed bookings reserve service time and the recorded preparation buffer until released.") Single bookings are checked against the artist’s travel time; mixed bookings have no pin and are not travel-checked.</p>
    <div class="admin-month" role="group" aria-label="@month.ToString("MMMM yyyy") appointments">
        @foreach (var weekday in new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }) { <strong class="calendar-weekday">@weekday</strong> }
        @for (var blank = 0; blank < (int)month.DayOfWeek; blank++) { <span aria-hidden="true"></span> }
        @for (var day = 1; day <= DateTime.DaysInMonth(month.Year, month.Month); day++) {
            var date = month.AddDays(day - 1); var entries = Model.Where(b => b.Start.Date == date && AdminPaymentLabels.OnCalendar(b)).ToList(); var blocked = blocks.Any(b => b.From < date.AddDays(1) && b.To > date);
            <a class="admin-calendar-day" asp-action="Appointments" asp-route-mode="calendar" asp-route-year="@month.Year" asp-route-month="@month.Month" asp-route-day="@day" aria-current="@(selectedDay == day ? "date" : null)" aria-label="@date.ToString("MMMM d"): @entries.Count appointments@(blocked ? ", blocked time" : "")"><strong>@day</strong><span>@if (entries.Count > 0) { <text>@entries.Count appointment(s)</text> } @if (blocked) { <text> · Blocked</text> }</span></a>
        }
    </div>
</section>
<section class="panel" aria-live="polite">
@if (!selectedDate.HasValue) { <h2>Select a date</h2><p>Choose a date in the calendar to see its appointments and blocked time.</p> }
else {
    <h2>@selectedDate.Value.ToString("dddd, MMMM d, yyyy")</h2>
    @if (!DataStore.IsPersistent) { var windows = (IReadOnlyList<ScheduleWindow>)ViewBag.OpenWindows; <h3>Open service / preparation windows</h3><p>Each service and its buffer must fit within a window. @(settings.LateFeeEnabled ? $"Final closing is {settings.LateEndHour}:00, not a start time." : "") These windows are service and preparation only; the travel rule is applied when a customer picks a pinned time.</p>@if (windows.Count == 0) { <p>No open windows remain.</p> } else { <ul>@foreach (var window in windows) { <li>@window.From.ToString("h:mm tt") – @window.To.ToString("h:mm tt")</li> }</ul> } }
    else { <p>Open reservation windows are unavailable until persistent scheduling is verified.</p> }
    @if (!dayBookings.Any() && !dayBlocks.Any()) { <p>No appointments or blocks recorded for this date. This is not a guarantee of availability.</p> }
    @foreach (var b in dayBookings) { @if (travelLines.TryGetValue(b.Id, out var travelLine)) { <p class="travel-line" data-travel-line>@travelLine</p> }<article class="calendar-item" data-calendar-booking="@b.Id"><div><strong>@b.Reference · @b.CustomerName</strong><p>@b.ServiceDescription · @b.BookingType · @AdminPaymentLabels.PeopleCount(b.People)</p><p>Makeup: @b.Start.ToString("h:mm tt") – @b.End.ToString("h:mm tt") · @((int)(b.End - b.Start).TotalMinutes) min · @b.Area</p><span class="badge @b.Status.ToLowerInvariant()">@b.DisplayStatus(DataStore.Now)</span><span class="badge">@b.PaymentStatus</span>@if (!DataStore.IsPersistent && (b.Status is "Pending Payment" or "Confirmed")) { <small>Preparation buffer until @b.End.AddMinutes(b.BufferMinutesSnapshot ?? settings.BufferMinutes).ToString("h:mm tt") · time reserved</small> } else { <small>No pending/confirmed reservation held.</small> }@if (b.MixedPeople.Count > 0) { <small>Travel and departure: not estimated; mixed bookings have no pin and are not travel-checked.</small> } else { <small>Time checked against the artist’s travel from her other bookings that day.</small> }@if (b.RequestedStart.HasValue) { <small>Reschedule requested; replacement is not reserved until approved.</small> }@if (b.MixedPeople.Count == 0 || User.IsInRole("SuperAdmin")) { <a asp-action="Details" asp-route-id="@b.Id">View @b.Reference</a> } else { <small>SuperAdmin review required</small> }</div></article> }
    @foreach (var b in dayBlocks) { <div class="block-item"><strong>Unavailable</strong><p>@b.From.ToString("MMM d, h:mm tt") – @b.To.ToString("MMM d, h:mm tt")</p></div> }
}
</section>
@if (User.IsInRole("SuperAdmin")) {
<div class="two-column"><section class="panel"><h3>Block unavailable time</h3><form asp-action="Block" method="post" class="stack"><label>From<input type="datetime-local" name="from" required /></label><label>Until<input type="datetime-local" name="to" required /></label><label>Reason<input name="reason" required /></label><button class="button secondary">Add time block ＋</button></form></section><section class="panel"><h3>Unavailable time</h3>@foreach (var b in blocks) { <div class="block-item"><strong>@b.Reason</strong><p>@b.From.ToString("MMM d, h:mm tt") – @b.To.ToString("MMM d, h:mm tt")</p><form asp-action="Unblock" method="post"><input name="id" type="hidden" value="@b.Id" /><button class="text-button">Remove block</button></form></div> }@if (!blocks.Any()) { <p>No time blocks added.</p> }</section></div>
}
