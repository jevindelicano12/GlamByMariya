@model List<Booking>
@inject XenditClient Xendit
@{ var appointmentsView = Context.Request.Query["view"] == "appointments"; ViewData["Title"] = appointmentsView ? "Appointments" : "Business overview"; var all = (List<Booking>)ViewBag.All; var payments = (List<Payment>)ViewBag.Payments; var online = Xendit.Enabled && DataStore.IsPersistent; }
@if (!appointmentsView) {
<div class="page-heading"><div><div class="eyebrow">HOME-SERVICE BOOKINGS AT A GLANCE</div><h1>A beautiful day ahead.</h1><p>Welcome back. Here’s what’s happening at Glam by Mariya.</p></div><a class="button" asp-controller="Admin" asp-action="Calendar">View calendar <span aria-hidden="true">→</span></a></div>
<div class="stats four"><div class="stat"><span>PENDING PAYMENT</span><strong>@all.Count(b => b.Status == "Pending Payment")</strong><small>@(online ? "Waiting for Xendit checkout" : "Down payments to verify")</small></div><div class="stat"><span>CONFIRMED APPOINTMENTS</span><strong>@all.Count(b => b.Status == "Confirmed")</strong><small>Your reserved moments</small></div><div class="stat"><span>RESCHEDULE REQUESTS</span><strong>@all.Count(b => b.RequestedStart != null)</strong><small>Keep original slots until approved</small></div><div class="stat"><span>VERIFIED COLLECTIONS</span><strong class="money">₱@payments.Where(p => p.Verified).Sum(p => p.Amount).ToString("N2")</strong><small>Before refunds</small></div></div>
<section class="panel upcoming-panel"><div class="section-title compact"><h3>Upcoming bookings</h3><a asp-action="Calendar">View calendar →</a></div>
@{ var upcoming = all.Where(b => b.Start >= DataStore.Now && (b.Status == "Confirmed" || b.Status == "Pending Payment")).OrderBy(b => b.Start).Take(4).ToList(); }
@if (upcoming.Count == 0) { <p>No upcoming bookings.</p> } else { <div class="upcoming-list">@foreach (var booking in upcoming) { <a class="upcoming-item" asp-action="Details" asp-route-id="@booking.Id"><span class="appointment-date"><small>@booking.Start.ToString("MMM")</small><strong>@booking.Start.ToString("dd")</strong></span><span><strong>@booking.CustomerName</strong><small>@booking.Service.Name · @booking.Start.ToString("h:mm tt")</small></span><span class="badge @booking.Status.ToLowerInvariant()">@booking.Status</span></a> }</div> }</section>
<div class="admin-banner"><div><span class="eyebrow">THE LITTLE DETAILS MATTER</span><h2>A seamless experience starts here.</h2><p>Review deposits, confirm your next appointments, and make space for beautiful moments.</p></div><span>✧</span></div>
}
<partial name="_AppointmentList" model="Model" />
