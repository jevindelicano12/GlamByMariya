@model IReadOnlyList<AdminRosterEntry>
@{ ViewData["Title"] = "Manage administrators"; }

<div class="page-heading">
    <div>
        <h1>Manage administrators</h1>
        <p>Review each Admin’s current account status before making a change.</p>
    </div>
    <span class="pill">SuperAdmin</span>
</div>

<section class="panel settings-card" aria-labelledby="roster-heading">
    <div>
        <h2 id="roster-heading">Admin accounts</h2>
        <p>Disabling an Admin ends their existing sessions. SuperAdmin accounts are not listed here.</p>
    </div>
    @if (Model.Count == 0)
    {
        <p>No Admin accounts are available.</p>
    }
    @foreach (var admin in Model)
    {
        <div class="detail-row">
            <span>
                <strong>@admin.Username</strong>
                <small>@admin.Email</small>
                <small>Status: @(admin.IsActive ? "Active" : "Disabled") · @(admin.IsLocked ? "Locked" : "Not locked") · Generation: @admin.SecurityGeneration</small>
            </span>
            @if (admin.IsActive)
            {
                <details>
                    <summary>Disable @admin.Username</summary>
                    <p>This will disable the account and invalidate its existing sessions.</p>
                    <form asp-action="DisableAdminFromRoster" method="post">
                        <input type="hidden" name="id" value="@admin.Id" />
                        <input type="hidden" name="expectedGeneration" value="@admin.SecurityGeneration" />
                        <button class="button secondary" type="submit">Confirm disable</button>
                    </form>
                </details>
            }
            else
            {
                <span>Already disabled</span>
            }
        </div>
    }
</section>
