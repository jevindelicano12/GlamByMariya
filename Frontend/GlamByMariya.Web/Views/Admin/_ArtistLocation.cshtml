@using System.Globalization
@using GlamByMariya.Core.Entities
@{
    var location = ViewBag.ArtistLocation as ArtistLocation;
    var now = (DateTime?)ViewBag.ArtistNow ?? DateTime.MinValue;
    string F(decimal? v) => v?.ToString("F6", CultureInfo.InvariantCulture) ?? "";
}
@if (location is null)
{
    <section class="panel stack artist-location" id="artist-location" data-artist-location-unavailable>
        <h3>Artist location</h3>
        <p role="status">Artist location is unavailable right now.</p>
    </section>
    return;
}
<link rel="stylesheet" href="~/lib/leaflet/leaflet.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/artist-location.css" asp-append-version="true" />
<section class="panel stack artist-location" id="artist-location" data-artist-location data-home-lat="@F(location.HomeLat)" data-home-lng="@F(location.HomeLng)" data-current-lat="@F(location.CurrentLat)" data-current-lng="@F(location.CurrentLng)">
    <h3>Artist location</h3>
    <p>Used to estimate travel to your first booking of the day. Search a place, drag the pin or click the map, then save it as your home base or as where you are right now. Pins must be inside Metro Manila or Rizal.</p>
    <p class="artist-location-state" data-artist-location-state>
        @(location.HomeLat.HasValue ? "Home base is set." : "Home base is not set yet.")
        @if (location.CurrentLat.HasValue && location.CurrentUpdatedAt.HasValue) { <text> Current location set @AdminTravelLines.Ago(location.CurrentUpdatedAt, now).</text> } else if (location.HomeLat.HasValue) { <text> No current location; the artist is assumed to be at home base.</text> } else { <text> No current location either, so the first booking of the day uses the minimum travel time.</text> }
    </p>
    <div class="artist-location-search" role="search">
        <input type="search" aria-label="Search a place or address" placeholder="Search a place or address, e.g. Novaliches" autocomplete="off" maxlength="200" data-artist-location-query />
        <button type="button" class="button secondary" data-artist-location-search>Search</button>
    </div>
    <div class="artist-location-map" data-artist-location-map role="application" aria-label="Map for placing the artist's home base and current location"></div>
    <p class="artist-location-status" role="status" aria-live="polite" data-artist-location-status></p>
    <div class="artist-location-actions">
        <button type="button" class="button secondary" data-artist-location-geolocate>Use my current location</button>
        <form asp-action="SetArtistCurrent" method="post" data-artist-location-form><input type="hidden" name="latitude" /><input type="hidden" name="longitude" /><button class="button">Save as current location</button></form>
        <form asp-action="SetArtistHome" method="post" data-artist-location-form><input type="hidden" name="latitude" /><input type="hidden" name="longitude" /><button class="button secondary">Set as home base</button></form>
        @* "Back to home base" only makes sense once a home base is saved; without one it just clears the current pin. *@
        @if (location.CurrentLat.HasValue) { <form asp-action="SetArtistCurrent" method="post"><input type="hidden" name="backHome" value="true" /><button class="button secondary">@(location.HomeLat.HasValue ? "Back to home base" : "Clear current location")</button></form> }
    </div>
</section>
<script src="~/lib/leaflet/leaflet.js" asp-append-version="true"></script>
<script src="~/js/artist-location.js" asp-append-version="true"></script>
