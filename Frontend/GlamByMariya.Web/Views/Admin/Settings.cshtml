@model BusinessSettings
@{ ViewData["Title"] = "Business Settings"; var isSuperAdmin = User.IsInRole("SuperAdmin"); }
@{ var paymentQr = (List<PaymentQrOption>)ViewBag.PaymentQr; }
@if (DataStore.IsPersistent) { <div class="notice">Database appointments and calendars use @Model.TimeZone. The server's operating-system timezone does not change your booking times.</div> }
@if (!isSuperAdmin) { <div class="notice">Only the SuperAdmin can change service hours, the preparation buffer or schedule blocks.</div> }
<div class="page-heading"><div><div class="eyebrow">BUSINESS SETTINGS</div><h1>A few thoughtful details.</h1><p>Set Makeup Artist Availability, confirmed service coverage, and payment instructions.</p></div></div><section class="panel settings-panel"><form asp-action="Settings" method="post" class="stack"><h3>Makeup Artist Availability & travel</h3><div class="form-grid"><label>Opening hour (0–23)<input name="openHour" type="number" min="0" max="23" value="@Model.OpenHour" required /></label><label>Closing hour (1–24)<input name="closeHour" type="number" min="1" max="24" value="@Model.CloseHour" required /></label><label>Travel / prep buffer (minutes)<input name="bufferMinutes" type="number" min="0" max="180" value="@Model.BufferMinutes" required /></label><input type="hidden" name="travelFee" value="@Model.TravelFee" /><div class="notice"><strong>Transportation policy</strong><br />Transportation reimbursement is a separate actual expense paid by the customer upon arrival after a receipt or agreed fare breakdown. The legacy informational flat-fee setting is retained for historical compatibility and is not used in new booking totals, down payments, or balances.</div><label>Down payment (1–100%)<input name="downPaymentPercent" type="number" min="1" max="100" step="1" value="@Model.DownPaymentPercent" @(isSuperAdmin ? null : "readonly") required /><small>@(isSuperAdmin ? "Applies to new bookings only. Existing bookings keep their recorded down payment." : "Only the SuperAdmin can change this percentage.")</small></label></div><label>Service areas (comma-separated)<textarea name="serviceAreas" rows="3" required>@Model.ServiceAreas</textarea></label><label>Customer payment instructions<textarea name="paymentInstructions" rows="4">@Model.PaymentInstructions</textarea><small>Provide your verified GCash, Maya and bank details before accepting real deposits.</small></label><div class="notice">Required down payment: @Model.DownPaymentPercent.ToString("N0")% of the final discounted total · Confirmed cancellation deduction: ₱200, allowed until 24 hours before the appointment · Unpaid bookings cancel free.<br />All times are the server’s local time. Existing booking prices are not changed by these settings.</div><label><input type="checkbox" name="confirmAffected" value="true" /> Save anyway if upcoming bookings fall outside the new hours (they keep their booked times)</label><button class="button">Save Business Settings ↗</button></form></section>
<section class="panel stack"><h3>Early &amp; Late Booking Fees</h3>
<p>Regular service hours are set above; only the SuperAdmin may change them. Early fees apply once per booking to all active packages when makeup starts from the early boundary up to, but not including, opening time. Travel departure does not affect the fee.</p>
<p>Demo settings and bookings reset on restart. A late fee applies once when makeup starts at or after the late-fee boundary, or a package starting during regular hours finishes makeup after regular closing. The early-start fee takes priority. Makeup and preparation must finish by final closing; travel departure is separate.</p>
@if (isSuperAdmin && !DataStore.IsPersistent) {
<form asp-action="FeeSettings" method="post" class="stack">
<label><input type="checkbox" name="earlyFeeEnabled" value="true" checked="@Model.EarlyFeeEnabled" /> Enable early fee</label>
<div class="form-grid"><label>Earliest makeup start (hour 0–23)<input type="number" name="earlyStartHour" min="0" max="23" value="@Model.EarlyStartHour" required /></label>
<label>Early surcharge (₱ per booking)<input type="number" name="earlyFee" min="0" max="1000000" step="0.01" value="@Model.EarlyFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
<label>Late fee starts (hour 0–23)<input type="number" name="lateStartHour" min="0" max="23" value="@Model.LateStartHour" /><small>Required when enabled; at or after regular opening and before final closing.</small></label>
<label>Final appointment closing (hour 1–24)<input type="number" name="lateEndHour" min="1" max="24" value="@Model.LateEndHour" required /><small>Makeup and preparation must finish by this time, at or after regular closing.</small></label>
<label>Late surcharge (₱ per booking)<input type="number" name="lateFee" min="0" max="1000000" step="0.01" value="@Model.LateFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label></div>
<label><input type="checkbox" name="lateFeeEnabled" value="true" checked="@Model.LateFeeEnabled" /> Enable late fee and bounded late bookings</label><button class="button">Save Demo fee policy</button></form>
} else { <p>Only the SuperAdmin can manage these settings in Demo mode. Persistent fee settings are unavailable.</p> }
</section>
<div class="section-title"><div><div class="eyebrow">PAYMENT METHODS</div><h2>Your payment QR codes.</h2></div></div>
<p class="help">Upload the QR for each payment method you accept. Customers see the matching image beside their booking summary. QR images stay saved on this server after a restart.</p>
<div class="payment-qr-admin-grid">
@foreach (var option in paymentQr)
{
    <section class="panel payment-qr-admin">
        <h3>@option.Method</h3>
        @if (option.ImageUrl != null)
        {
            <a href="@option.ImageUrl" target="_blank" rel="noopener"><img class="payment-qr-image" src="@option.ImageUrl" alt="Current @option.Method payment QR" /></a>
        }
        else { <div class="payment-qr-placeholder">No QR uploaded yet</div> }
        <form asp-action="SavePaymentQr" method="post" enctype="multipart/form-data" class="stack">
            <input type="hidden" name="method" value="@option.Method" />
            <label>@(option.ImageUrl == null ? "Upload QR image" : "Replace QR image")<input type="file" name="qr" accept="image/png,image/jpeg" required /><small>JPG or PNG · maximum 5 MB. Upload a clear, uncropped QR from your payment app.</small></label>
            <button class="button secondary">Save @option.Method QR</button>
        </form>
        @if (option.ImageUrl != null)
        {
            <form asp-action="RemovePaymentQr" method="post" class="delete-form"><input type="hidden" name="method" value="@option.Method" /><button class="text-button">Remove QR code</button></form>
        }
    </section>
}
</div>
