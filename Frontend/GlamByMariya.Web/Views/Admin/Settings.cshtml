@model BusinessSettings
@inject XenditClient Xendit
@{ ViewData["Title"] = "Business Settings"; var isSuperAdmin = User.IsInRole("SuperAdmin"); var online = Xendit.Enabled && DataStore.IsPersistent; }
@if (DataStore.IsPersistent) { <div class="notice">Database appointments and calendars use @Model.TimeZone. The server's operating-system timezone does not change your booking times.</div> }
@if (!isSuperAdmin) { <div class="notice">Only the SuperAdmin can change service hours, the preparation buffer or schedule blocks.</div> }
<div class="page-heading"><div><div class="eyebrow">BUSINESS SETTINGS</div><h1>A few thoughtful details.</h1><p>@(online ? "Set Makeup Artist Availability and confirmed service coverage. Customers pay the down payment online through Xendit." : "Set Makeup Artist Availability, confirmed service coverage, and payment instructions.")</p></div></div>
<nav class="tabs settings-tabs" role="tablist" aria-label="Business settings sections">
    <button type="button" role="tab" class="active" aria-selected="true" data-settings-tab="availability">Availability &amp; rules</button>
    <button type="button" role="tab" aria-selected="false" data-settings-tab="location">Artist location</button>
    <button type="button" role="tab" aria-selected="false" data-settings-tab="fees">Early &amp; late fees</button>
</nav>
<div class="settings-tab-panel" data-settings-panel="availability">
<section class="panel settings-panel"><form asp-action="Settings" method="post" class="stack">
<div class="settings-group">
    <div class="settings-group-head"><h3>Service hours &amp; booking rules</h3><p>Regular hours, optional early/late boundaries, group size, advance window, and deposit rate.</p></div>
    <div class="form-grid cols-4">
        <label>Opening hour (0–23)<input name="openHour" type="number" min="0" max="23" value="@Model.OpenHour" required /><small class="help">Start of regular hours.</small></label>
        <label>Closing hour (1–24)<input name="closeHour" type="number" min="1" max="24" value="@Model.CloseHour" required /><small class="help">End of regular hours.</small></label>
        <label>Early booking from<input name="earlyRequestStartHour" type="number" min="0" max="23" value="@Model.EarlyRequestStartHour" placeholder="Same as opening" /><small class="help">Optional; requires approval.</small></label>
        <label>Latest end<input name="afterHoursEndHour" type="number" min="1" max="24" value="@Model.AfterHoursEndHour" placeholder="Same as closing" /><small class="help">Optional after-hours cap.</small></label>
    </div>
    <div class="form-grid cols-3">
        <label>Max people per booking<input name="maxPeople" type="number" min="1" max="20" step="1" value="@Model.MaxPeople" required /><small class="help">1 to 20 people (groups &amp; packages).</small></label>
        <label>Max advance booking (days)<input name="maxAdvanceBookingDays" type="number" min="1" max="365" step="1" value="@Model.MaxAdvanceBookingDays" @(isSuperAdmin ? null : "readonly") required /><small class="help">e.g. 15 or 30 days ahead.</small></label>
        <label>Down payment (1–100%)<input name="downPaymentPercent" type="number" min="1" max="100" step="1" value="@Model.DownPaymentPercent" @(isSuperAdmin ? null : "readonly") required /><small>@(isSuperAdmin ? "Applies to new bookings only." : "SuperAdmin only.")</small></label>
    </div>
</div>
<div class="settings-group">
    <div class="settings-group-head"><h3>Travel &amp; preparation estimates</h3><p>Buffer time between bookings and travel fallback when a customer has no map pin.</p></div>
    <div class="form-grid cols-3">
        <label>Travel / prep buffer (min)<input name="bufferMinutes" type="number" min="0" max="180" value="@Model.BufferMinutes" required /><small>Prep &amp; cleanup between bookings.</small></label>
        <label>Travel speed (km/h, 5–60)<input name="travelSpeedKmh" type="number" min="5" max="60" step="1" value="@Model.TravelSpeedKmh.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" required /><small>Used to estimate travel between bookings.</small></label>
        <label>Minimum travel (min, 0–180)<input name="travelMinimumMinutes" type="number" min="0" max="180" value="@Model.TravelMinimumMinutes" required /><small>Fallback when no pin is set.</small></label>
    </div>
    <input type="hidden" name="travelFee" value="@Model.TravelFee" />
    <div class="notice"><strong>Transportation policy:</strong> Separate actual expense paid by the customer upon arrival after a receipt or agreed fare breakdown (legacy flat-fee setting is inactive).</div>
</div>
<div class="settings-group">
    <div class="settings-group-head"><h3>Coverage, payment &amp; policies</h3><p>Service areas, deposit instructions, and customer-facing booking terms.</p></div>
    <div class="settings-textareas"><label>Service areas (comma-separated)<textarea name="serviceAreas" rows="3" required>@Model.ServiceAreas</textarea><small>Cities or areas eligible for home service.</small></label>@if (!online) { <label>Customer payment instructions<textarea name="paymentInstructions" rows="3">@Model.PaymentInstructions</textarea><small>Provide verified GCash, Maya, and bank details before accepting deposits.</small></label> } else { <input type="hidden" name="paymentInstructions" value="@Model.PaymentInstructions" /> }</div>
    <div class="policy-launcher"><div><strong>Customer-facing policies</strong><p class="help">Required down payment: @Model.DownPaymentPercent.ToString("N0")% of final total · @(DataStore.IsPersistent ? $"All times in {Model.TimeZone}." : "All times in server local time.") Existing booking prices stay unchanged.</p></div><button type="button" class="button secondary" data-open-dialog="policies-modal">@(isSuperAdmin ? "Edit policies" : "View policies")</button></div>
</div>
<div class="settings-submit-row"><label><input type="checkbox" name="confirmAffected" value="true" /> Save anyway if upcoming bookings fall outside the new hours (they keep their booked times)</label><button class="button">Save business settings</button></div></form></section>
</div>
<dialog id="policies-modal" class="policies-modal" aria-labelledby="policies-modal-title">
    <form asp-action="Policies" method="post" class="stack policies-modal-form">
        <div class="policies-modal-head"><div><div class="eyebrow">CUSTOMER-FACING POLICIES</div><h3 id="policies-modal-title">@(isSuperAdmin ? "Edit policies" : "Current policies")</h3></div><button type="button" class="button secondary policies-modal-close" data-close-dialog="policies-modal" aria-label="Close">✕</button></div>
        <p class="help">@(isSuperAdmin ? "Changes appear immediately on the Booking page, popups, and Terms & Conditions. Leave a field blank to restore its default wording." : "Only the SuperAdmin can edit customer-facing policies.")</p>
        <label>Payment policy<textarea name="paymentPolicy" rows="3" maxlength="2000" readonly="@(!isSuperAdmin)">@Model.PaymentPolicy</textarea></label>
        <label>Cancellation policy<textarea name="cancellationPolicy" rows="3" maxlength="2000" readonly="@(!isSuperAdmin)">@Model.CancellationPolicy</textarea></label>
        <label>Rescheduling policy<textarea name="reschedulingPolicy" rows="3" maxlength="2000" readonly="@(!isSuperAdmin)">@Model.ReschedulingPolicy</textarea></label>
        <label>Transportation policy<textarea name="transportationPolicy" rows="3" maxlength="2000" readonly="@(!isSuperAdmin)">@Model.TransportationPolicy</textarea></label>
        <label>After-hours / late booking policy<textarea name="afterHoursPolicy" rows="3" maxlength="2000" readonly="@(!isSuperAdmin)">@Model.AfterHoursPolicy</textarea></label>
        <div class="policies-modal-actions"><button type="button" class="button secondary" data-close-dialog="policies-modal">@(isSuperAdmin ? "Cancel" : "Close")</button>@if (isSuperAdmin) { <button type="submit" class="button">Save policies</button> }</div>
    </form>
</dialog>
<div class="settings-tab-panel" data-settings-panel="location" hidden>
<partial name="_ArtistLocation" />
</div>
<div class="settings-tab-panel" data-settings-panel="fees" hidden>
<section class="panel stack"><h3>Early &amp; Late Booking Fees</h3>
<p>Regular service hours are set in Availability &amp; rules; only the SuperAdmin may change them. Early fees apply once per booking when makeup starts before regular opening time. Travel departure does not affect the fee.</p>
<p>@if (!DataStore.IsPersistent) { <text>Demo settings and bookings reset on restart. </text> }A late fee applies once when makeup starts at or after the late-fee boundary, or finishes makeup after regular closing. Makeup and preparation must finish by final closing.</p>
@if (isSuperAdmin && !DataStore.IsPersistent) {
<form asp-action="FeeSettings" method="post" class="stack">
<label><input type="checkbox" name="earlyFeeEnabled" value="true" checked="@Model.EarlyFeeEnabled" /> Enable early fee</label>
<div class="form-grid"><label>Earliest makeup start (hour 0–23)<input name="earlyStartHour" type="number" min="0" max="23" value="@Model.EarlyStartHour" required /></label>
<label>Early surcharge (₱ per booking)<input name="earlyFee" type="number" min="0" max="1000000" step="0.01" value="@Model.EarlyFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
<label>Late fee starts (hour 0–23)<input name="lateStartHour" type="number" min="0" max="23" value="@Model.LateStartHour" /><small>Between regular opening and final closing.</small></label>
<label>Final appointment closing (hour 1–24)<input name="lateEndHour" type="number" min="1" max="24" value="@Model.LateEndHour" required /><small>Makeup &amp; prep must finish by this time.</small></label>
<label>Late surcharge (₱ per booking)<input name="lateFee" type="number" min="0" max="1000000" step="0.01" value="@Model.LateFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label></div>
<div class="settings-submit-row"><label><input type="checkbox" name="lateFeeEnabled" value="true" checked="@Model.LateFeeEnabled" /> Enable late fee and bounded late bookings</label><button class="button">Save Demo fee policy</button></div></form>
} else { <p>@(DataStore.IsPersistent ? "Early and late fee settings can't be changed on the live site yet." : "Only the SuperAdmin can manage these settings in Demo mode.")</p> }
</section>
</div>
@section Scripts {
@{ var cspNonce = Context.Items["csp-nonce"] as string; }
<script nonce="@cspNonce">
(() => {
  const tabs = document.querySelectorAll('[data-settings-tab]');
  const panels = document.querySelectorAll('[data-settings-panel]');
  if (!tabs.length || !panels.length) return;
  const activate = (name, save) => {
    tabs.forEach(t => {
      const on = t.dataset.settingsTab === name;
      t.classList.toggle('active', on);
      t.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    panels.forEach(p => { p.hidden = p.dataset.settingsPanel !== name; });
    if (save) try { sessionStorage.setItem('admin-settings-tab', name); } catch {}
    if (name === 'location') window.dispatchEvent(new Event('resize'));
  };
  tabs.forEach(t => t.addEventListener('click', () => activate(t.dataset.settingsTab, true)));
  try {
    const saved = sessionStorage.getItem('admin-settings-tab');
    if (saved && document.querySelector(`[data-settings-tab="${saved}"]`)) activate(saved, false);
  } catch {}
})();
</script>
}
