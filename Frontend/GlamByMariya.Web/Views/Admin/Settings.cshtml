@model BusinessSettings
@inject XenditClient Xendit
@{ ViewData["Title"] = "Business Settings"; var isSuperAdmin = User.IsInRole("SuperAdmin"); var online = Xendit.Enabled && DataStore.IsPersistent; }
@{ var paymentQr = (List<PaymentQrOption>)ViewBag.PaymentQr; }
@if (DataStore.IsPersistent) { <div class="notice">Database appointments and calendars use @Model.TimeZone. The server's operating-system timezone does not change your booking times.</div> }
@if (!isSuperAdmin) { <div class="notice">Only the SuperAdmin can change service hours, the preparation buffer or schedule blocks.</div> }
<div class="page-heading"><div><div class="eyebrow">BUSINESS SETTINGS</div><h1>A few thoughtful details.</h1><p>@(online ? "Set Makeup Artist Availability and confirmed service coverage. Customers pay the down payment online through Xendit." : "Set Makeup Artist Availability, confirmed service coverage, and payment instructions.")</p></div></div><section class="panel settings-panel"><form asp-action="Settings" method="post" class="stack"><h3>Makeup Artist Availability & travel</h3><div class="form-grid"><label>Opening hour (0–23)<input name="openHour" type="number" min="0" max="23" value="@Model.OpenHour" required /></label><label>Closing hour (1–24)<input name="closeHour" type="number" min="1" max="24" value="@Model.CloseHour" required /></label><label>Travel / prep buffer (minutes)<input name="bufferMinutes" type="number" min="0" max="180" value="@Model.BufferMinutes" required /></label><input type="hidden" name="travelFee" value="@Model.TravelFee" /><div class="notice"><strong>Transportation policy</strong><br />Transportation reimbursement is a separate actual expense paid by the customer upon arrival after a receipt or agreed fare breakdown. The legacy informational flat-fee setting is retained for historical compatibility and is not used in new booking totals, down payments, or balances.</div><label>Down payment (1–100%)<input name="downPaymentPercent" type="number" min="1" max="100" step="1" value="@Model.DownPaymentPercent" @(isSuperAdmin ? null : "readonly") required /><small>@(isSuperAdmin ? "Applies to new bookings only. Existing bookings keep their recorded down payment." : "Only the SuperAdmin can change this percentage.")</small></label></div><label>Service areas (comma-separated)<textarea name="serviceAreas" rows="3" required>@Model.ServiceAreas</textarea></label>@if (!online) { <label>Customer payment instructions<textarea name="paymentInstructions" rows="4">@Model.PaymentInstructions</textarea><small>Provide your verified GCash, Maya and bank details before accepting real deposits.</small></label> } else { <input type="hidden" name="paymentInstructions" value="@Model.PaymentInstructions" /> }<div class="notice">Required down payment: @Model.DownPaymentPercent.ToString("N0")% of the final discounted total · Confirmed cancellation deduction: ₱200, allowed until 24 hours before the appointment · Unpaid bookings cancel free.@(DataStore.IsPersistent ? " A cancellation by the business has no fee." : "")<br />@(DataStore.IsPersistent ? $"All times are in {Model.TimeZone}." : "All times are the server’s local time.") Existing booking prices are not changed by these settings.</div><label><input type="checkbox" name="confirmAffected" value="true" /> Save anyway if upcoming bookings fall outside the new hours (they keep their booked times)</label><button class="button">Save Business Settings ↗</button></form></section>
<section class="panel stack"><h3>Early &amp; Late Booking Fees</h3>
<p>Regular service hours are set above; only the SuperAdmin may change them. Early fees apply once per booking to all active packages when makeup starts from the early boundary up to, but not including, opening time. Travel departure does not affect the fee.</p>
<p>@if (!DataStore.IsPersistent) { <text>Demo settings and bookings reset on restart. </text> }A late fee applies once when makeup starts at or after the late-fee boundary, or a booking (individual or package) starting during regular hours finishes makeup after regular closing. The early-start fee takes priority. Makeup and preparation must finish by final closing; travel departure is separate.</p>
@if (isSuperAdmin && !DataStore.IsPersistent) {
<form asp-action="FeeSettings" method="post" class="stack">
<label><input type="checkbox" name="earlyFeeEnabled" value="true" checked="@Model.EarlyFeeEnabled" /> Enable early fee</label>
<div class="form-grid"><label>Earliest makeup start (hour 0–23)<input type="number" name="earlyStartHour" min="0" max="23" value="@Model.EarlyStartHour" required /></label>
<label>Early surcharge (₱ per booking)<input type="number" name="earlyFee" min="0" max="1000000" step="0.01" value="@Model.EarlyFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
<label>Late fee starts (hour 0–23)<input type="number" name="lateStartHour" min="0" max="23" value="@Model.LateStartHour" /><small>Required when enabled; at or after regular opening and before final closing.</small></label>
<label>Final appointment closing (hour 1–24)<input type="number" name="lateEndHour" min="1" max="24" value="@Model.LateEndHour" required /><small>Makeup and preparation must finish by this time, at or after regular closing.</small></label>
<label>Late surcharge (₱ per booking)<input type="number" name="lateFee" min="0" max="1000000" step="0.01" value="@Model.LateFee.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label></div>
<label><input type="checkbox" name="lateFeeEnabled" value="true" checked="@Model.LateFeeEnabled" /> Enable late fee and bounded late bookings</label><button class="button">Save Demo fee policy</button></form>
} else { <p>@(DataStore.IsPersistent ? "Early and late fee settings can't be changed on the live site yet." : "Only the SuperAdmin can manage these settings in Demo mode.")</p> }
</section>
@{ var ts = DataStore.Settings; var tenKm = GlamByMariya.Core.BusinessRules.TravelEstimate.Minutes(ts, (double)ts.ServiceCenterLat, (double)ts.ServiceCenterLng, (double)ts.ServiceCenterLat + 0.0899, (double)ts.ServiceCenterLng); }
<section class="panel stack travel-settings"><h3>Travel time between appointments</h3>
<p>Customers pin their location before choosing a time. The artist is at the first customer's place by the booked time; between two appointments the calendar also keeps the estimated travel time free, after the session and the @ts.BufferMinutes-minute preparation buffer.</p>
<p class="help">Estimate = straight-line distance × road factor ÷ average speed, plus a safety margin, rounded up to 5 minutes. With the current settings a 10 km trip takes about <strong>@tenKm minutes</strong>. Example: a 7:00–9:00 booking followed by a customer 1 hour away leaves the next time at 9:00 + @ts.BufferMinutes min preparation + 1 hour travel.</p>
@if (isSuperAdmin) {
<form asp-action="TravelSettings" method="post" class="form-grid">
    <label>Average speed (km/h)<input name="travelSpeedKmh" type="number" min="5" max="120" step="0.1" value="@ts.TravelSpeedKmh.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
    <label>Road factor (1 = straight line)<input name="travelRoadFactor" type="number" min="1" max="3" step="0.01" value="@ts.TravelRoadFactor.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
    <label>Safety margin (minutes)<input name="travelMarginMinutes" type="number" min="0" max="120" step="1" value="@ts.TravelMarginMinutes" required /></label>
    <label>Travel for an old booking with no pin (minutes)<input name="travelUnknownMinutes" type="number" min="0" max="240" step="1" value="@ts.TravelUnknownMinutes" required /></label>
    <label>Service area centre — latitude<input name="serviceCenterLat" type="number" min="-90" max="90" step="0.000001" value="@ts.ServiceCenterLat.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
    <label>Service area centre — longitude<input name="serviceCenterLng" type="number" min="-180" max="180" step="0.000001" value="@ts.ServiceCenterLng.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
    <label>Service radius (km)<input name="serviceRadiusKm" type="number" min="1" max="500" step="0.1" value="@ts.ServiceRadiusKm.ToString(System.Globalization.CultureInfo.InvariantCulture)" required /></label>
    <div><button class="button" type="submit">Save travel settings</button></div>
</form>
} else { <p>Only the SuperAdmin can change travel settings. Current: @ts.TravelSpeedKmh km/h, road factor @ts.TravelRoadFactor, margin @ts.TravelMarginMinutes min, radius @ts.ServiceRadiusKm km.</p> }
</section>
@if (!online) {
<div class="section-title"><div><div class="eyebrow">PAYMENT METHODS</div><h2>Your payment QR codes.</h2></div></div>
<p class="help">Upload the QR for each payment method you accept. Customers see the matching image beside their booking summary. QR images stay saved on this server after a restart.</p>
<div class="payment-qr-admin-grid">
@foreach (var option in paymentQr)
{
    <section class="panel payment-qr-admin">
        <h3>@option.Method</h3>
        @if (option.ImageUrl != null)
        {
            <a href="@option.ImageUrl" target="_blank" rel="noopener"><img class="payment-qr-image" src="@option.ImageUrl" alt="Current @option.Method payment QR" /></a>
        }
        else { <div class="payment-qr-placeholder">No QR uploaded yet</div> }
        <form asp-action="SavePaymentQr" method="post" enctype="multipart/form-data" class="stack">
            <input type="hidden" name="method" value="@option.Method" />
            <label>@(option.ImageUrl == null ? "Upload QR image" : "Replace QR image")<input type="file" name="qr" accept="image/png,image/jpeg" required /><small>JPG or PNG · maximum 5 MB. Upload a clear, uncropped QR from your payment app.</small></label>
            <button class="button secondary">Save @option.Method QR</button>
        </form>
        @if (option.ImageUrl != null)
        {
            <form asp-action="RemovePaymentQr" method="post" class="delete-form"><input type="hidden" name="method" value="@option.Method" /><button class="text-button">Remove QR code</button></form>
        }
    </section>
}
</div>
}
