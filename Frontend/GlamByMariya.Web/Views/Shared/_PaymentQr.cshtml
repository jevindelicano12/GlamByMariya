@model List<PaymentQrOption>
<section class="payment-qr-panel" aria-label="Payment QR code">
    <div class="eyebrow">PAY YOUR DEPOSIT</div>
    @foreach (var option in Model)
    {
        <div data-payment-qr="@option.Method">
            <h4>@option.Method</h4>
            @if (option.ImageUrl != null)
            {
                <a href="@option.ImageUrl" target="_blank" rel="noopener" title="Open full-size @option.Method QR code">
                    <img class="payment-qr-image" src="@option.ImageUrl" alt="Business’s @option.Method payment QR code" />
                </a>
                <p class="help">Scan with @option.Method or open the image full size. Verify the recipient in your payment app before sending your deposit.</p>
            }
            else
            {
                <p class="payment-qr-empty">The artist hasn’t uploaded a @option.Method QR yet. Follow the payment instructions or contact the artist for account details.</p>
            }
        </div>
    }
    <small>Pay manually, then enter your transaction reference and submit your payment screenshot. Selecting a QR does not charge you.</small>
</section>
