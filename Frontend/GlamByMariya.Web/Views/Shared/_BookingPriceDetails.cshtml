@model Booking
<section class="panel stack booking-price-details" aria-label="Booking price and payment record">
    <h3>Price &amp; payment record</h3>
    <div class="detail-row"><span>Service / number of people</span><strong>@(Model.MixedPeople.Count > 0 ? "Mixed-service group" : Model.Service.Name) / @Model.People</strong></div>
    @if (Model.MixedPeople.Count == 0) {
    <div class="detail-row"><span>Regular price per person</span><strong>₱@Model.Service.Price.ToString("N2")</strong></div>
    <div class="detail-row"><span>Group price per person</span><strong>@(!Model.GroupPrice.HasValue ? "Not offered" : Model.People < Model.GroupMinimumPeople ? $"Not applied (needs {Model.GroupMinimumPeople}+ people)" : $"₱{Model.GroupPrice.Value:N2} ({Model.GroupMinimumPeople}+ people)")</strong></div>
    }
    <div class="detail-row"><span>Original service total</span><strong>₱@Model.OriginalTotal.ToString("N2")</strong></div>
    <div class="detail-row"><span>Group discount</span><strong>−₱@Model.GroupDiscount.ToString("N2")</strong></div>
    <div class="detail-row"><span>Selected add-ons</span><strong>₱@((Model.MixedPeople.Count > 0 ? Model.MixedPeople.Sum(p => p.AddOns.Sum(a => a.Price * a.Quantity)) : Model.AddOns.Sum(a => a.Price * a.Quantity)).ToString("N2"))</strong></div>
    <div class="detail-row"><span>Early booking surcharge</span><strong>₱@((Model.ApprovedReschedules.LastOrDefault()?.Quote.EarlyFee ?? Model.EarlyFeeSnapshot).ToString("N2"))</strong></div>
    <div class="detail-row"><span>Late booking surcharge</span><strong>₱@((Model.ApprovedReschedules.LastOrDefault()?.Quote.LateFee ?? Model.LateFeeSnapshot).ToString("N2"))</strong></div>
    <div class="detail-row"><span>Transportation reimbursement</span><strong>Separate actual expense</strong></div>
    <div class="detail-row"><span>Final booking total</span><strong>₱@Model.Total.ToString("N2")</strong></div>
    <div class="detail-row"><span>Required down payment (@Model.DownPaymentPercentSnapshot.ToString("N0")%)</span><strong>₱@Model.RequiredDownPayment.ToString("N2")</strong></div>
    <div class="detail-row"><span>Balance after down payment</span><strong>₱@Model.BalanceAfterDeposit.ToString("N2")</strong></div>
    <p class="travel-note">Transportation expenses are not included. The actual transportation fee will be reimbursed separately upon the makeup artist's arrival, after presenting a receipt or agreed fare breakdown. It is separate from the remaining makeup balance.</p>
    <div class="detail-row"><span>Verified paid / outstanding balance</span><strong>₱@Model.VerifiedPaid.ToString("N2") / ₱@Model.RemainingBalance.ToString("N2")</strong></div>
    <div class="detail-row"><span>Payment status</span><strong>@(Model.Status == "Pending Payment" && (ViewBag.Payments as List<Payment>)?.Any(p => p.ReviewStatus == "Correction Requested") == true ? "Correction requested" : Model.PaymentStatus)</strong></div>
</section>
