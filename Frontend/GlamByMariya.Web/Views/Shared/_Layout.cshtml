@{ var authenticated = User.Identity?.IsAuthenticated == true; var staff = GlamByMariya.Core.Entities.Roles.IsStaff(User); var owner = GlamByMariya.Core.Entities.Roles.IsSuperAdmin(User); var controller = ViewContext.RouteData.Values["controller"]?.ToString(); var action = ViewContext.RouteData.Values["action"]?.ToString(); var cspNonce = Context.Items["csp-nonce"] as string;
   var activeNav = controller switch {
       "Admin" => action switch { "Index" => Context.Request.Query["view"] == "appointments" ? "appointments" : "overview", "Appointments" or "Details" or "Calendar" => "appointments", "Customers" or "Customer" => "customers", "Catalog" => "catalog", "Reports" => "reports", "Payments" => "payments", "Settings" => "business-settings", "Users" or "ManageAccounts" => "users", "Activity" => "activity", _ => null },
       "WebsiteContent" => "website-content", "DemoGallery" => "gallery", "Account" when action == "Settings" => "account-settings", _ => null
   }; }
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" /><meta name="theme-color" content="#FFF8F4" /><meta name="description" content="Glam by Mariya is a home-service makeup business. One makeup artist travels to your selected location for your appointment." /><title>@ViewData["Title"] · Glam by Mariya — Home-Service Makeup Booking and Reservation System</title><link rel="icon" type="image/svg+xml" href="~/favicon.svg" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/availability.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/booking-refinement.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/catalog-images.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/branding.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/workspace-redesign.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/customer-beauty.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/public-refinement.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/interaction-polish.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/mobile-menu.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/typography-system.css" asp-append-version="true" /></head>

<body class="@(authenticated ? (staff ? "member-layout staff-layout " : "member-layout customer-layout ") : "guest-layout ")@(controller == "Home" ? "landing-page" : controller == "Bookings" && action == "Create" ? "booking-page" : "")">
@if (controller == "Home" && action == "Index" && !staff) { <partial name="_IntroSplash" /> }
@if (authenticated && staff) {
<script nonce="@cspNonce">try { if (localStorage.getItem('lumiere-sidebar') === 'collapsed') document.body.classList.add('sidebar-collapsed'); } catch { }</script>
<aside class="sidebar" id="studio-sidebar">
    <button class="brand" type="button" id="sidebar-toggle" aria-controls="studio-sidebar" aria-expanded="true" aria-label="Collapse sidebar" title="Collapse sidebar"><span class="brand-mark">G<span>✦</span></span><span class="brand-name">GLAM BY MARIYA<small>HOME SERVICE</small></span></button>
    <div class="nav-label">@(staff ? "MAKEUP ARTIST WORKSPACE" : "HOME-SERVICE MAKEUP")</div>
    <div class="staff-menu" id="staff-mobile-menu" data-mobile-menu="(max-width: 850px)"><button type="button" class="menu-toggle" aria-expanded="false" aria-controls="staff-menu-panel" aria-label="Open menu"><span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span></button><div class="menu-backdrop" data-menu-close></div><nav id="staff-menu-panel" aria-label="Staff navigation">
    @if (staff) {
        <a class="@(activeNav == "overview" ? "selected" : null)" aria-current="@(activeNav == "overview" ? "page" : null)" asp-controller="Admin" asp-action="Index"><span>▦</span> Overview</a>
        <a class="@(activeNav == "appointments" ? "selected" : null)" aria-current="@(activeNav == "appointments" ? "page" : null)" asp-controller="Admin" asp-action="Appointments"><span>▤</span> Appointments</a>
        <a class="@(activeNav == "customers" ? "selected" : null)" aria-current="@(activeNav == "customers" ? "page" : null)" asp-controller="Admin" asp-action="Customers"><span>☺</span> Customers</a>
        <a class="@(activeNav == "catalog" ? "selected" : null)" aria-current="@(activeNav == "catalog" ? "page" : null)" asp-controller="Admin" asp-action="Catalog"><span>✧</span> Makeup Services & add-ons</a>
        <a class="@(activeNav == "reports" ? "selected" : null)" aria-current="@(activeNav == "reports" ? "page" : null)" asp-controller="Admin" asp-action="Reports"><span>◴</span> Sales Reports</a>
        <a class="@(activeNav == "payments" ? "selected" : null)" aria-current="@(activeNav == "payments" ? "page" : null)" asp-controller="Admin" asp-action="Payments"><span>◈</span> Payments</a>
        <a class="@(activeNav == "business-settings" ? "selected" : null)" aria-current="@(activeNav == "business-settings" ? "page" : null)" asp-controller="Admin" asp-action="Settings"><span>⚙</span> Business Settings</a>
        @if (owner) { <a class="@(activeNav == "users" ? "selected" : null)" aria-current="@(activeNav == "users" ? "page" : null)" asp-controller="Admin" asp-action="Users"><span>⚘</span> Manage administrators</a><a class="@(activeNav == "website-content" ? "selected" : null)" aria-current="@(activeNav == "website-content" ? "page" : null)" asp-controller="WebsiteContent" asp-action="Index"><span>✎</span> Website Content Management</a>@if (Context.RequestServices.GetService<GlamByMariya.Infrastructure.Integrations.DemoGalleryStore>() != null) { <a class="@(activeNav == "gallery" ? "selected" : null)" aria-current="@(activeNav == "gallery" ? "page" : null)" asp-controller="DemoGallery" asp-action="Index"><span>▧</span> Gallery Management</a> } }
        @if (owner && !DataStore.IsPersistent) { <a class="@(activeNav == "activity" ? "selected" : null)" aria-current="@(activeNav == "activity" ? "page" : null)" asp-controller="Admin" asp-action="Activity"><span>◷</span> Activity Logs</a> }
    } else {
        <a class="@(controller == "Home" ? "selected" : "")" asp-controller="Home" asp-action="Index"><span>▦</span> Discover home-service makeup</a>
        <a class="@(controller == "Bookings" && action != "Create" ? "selected" : "")" asp-controller="Bookings" asp-action="Index"><span>▤</span> My appointments</a>
        <a class="@(action == "Create" ? "selected" : "")" asp-controller="Bookings" asp-action="Create"><span>✧</span> Book an appointment</a>
    }
    @if (User.Identity?.IsAuthenticated == true) { <a class="@(activeNav == "account-settings" ? "selected" : null)" aria-current="@(activeNav == "account-settings" ? "page" : null)" asp-controller="Account" asp-action="Settings"><span>⚙</span> Account settings</a> }
    </nav></div>
    <div class="sidebar-bottom"><div class="studio-note"><span>✦</span><strong>Beauty, on your terms.</strong><p>Your makeup artist travels<br />to your chosen location.</p></div></div>
</aside>
}
<div class="workspace">
    <header class="topbar">@if (authenticated && staff) { <span>GLAM BY MARIYA <span class="divider">/</span> Makeup artist workspace</span><div class="account"><partial name="_AccountMenu" /></div> } else if (authenticated) { <a class="guest-brand" asp-controller="Home" asp-action="Index" aria-label="Glam by Mariya home"><span class="guest-brand-mark" aria-hidden="true">G<span>✦</span></span><span>GLAM BY MARIYA<small>HOME-SERVICE MAKEUP</small></span></a><nav class="customer-desktop-nav" aria-label="Customer navigation"><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Home" asp-action="Services">Services</a><a asp-controller="Home" asp-action="Gallery">Gallery</a><a asp-controller="Home" asp-action="About">About</a><a asp-controller="Home" asp-action="Contact">Contact</a></nav><div class="customer-mobile-menu mobile-menu" data-mobile-menu="(max-width: 1100px)"><button type="button" class="menu-toggle" aria-expanded="false" aria-controls="customer-menu-panel" aria-label="Open menu"><span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span></button><div class="menu-backdrop" data-menu-close></div><div class="menu-panel" id="customer-menu-panel"><p class="menu-signed-in">Signed in as <strong>@User.Identity?.Name</strong></p><nav aria-label="Customer mobile navigation"><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Home" asp-action="Services">Services</a><a asp-controller="Home" asp-action="Gallery">Gallery</a><a asp-controller="Home" asp-action="About">About</a><a asp-controller="Home" asp-action="Contact">Contact</a><a asp-controller="Bookings" asp-action="Index">My appointments</a><a asp-controller="Account" asp-action="Settings">My profile</a></nav><form class="menu-signout" asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Sign out</button></form></div></div><div class="account"><partial name="_AccountMenu" /></div> } else { <a class="guest-brand" asp-controller="Home" asp-action="Index" aria-label="Glam by Mariya home"><span class="guest-brand-mark" aria-hidden="true">G<span>✦</span></span><span>GLAM BY MARIYA<small>HOME-SERVICE MAKEUP</small></span></a><nav class="public-desktop-nav" aria-label="Website"><a href="/#home">Home</a><a href="/Home/About">About</a><a href="/Home/Services">Services</a><a href="/Home/Gallery">Gallery</a><a href="/Home/Contact">Contact</a><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Create", "Bookings")">Book Now</a></nav><div class="public-menu mobile-menu" data-mobile-menu="(max-width: 1050px)"><button type="button" class="menu-toggle" aria-expanded="false" aria-controls="public-menu-panel" aria-label="Open menu"><span class="menu-icon" aria-hidden="true"><span></span><span></span><span></span></span></button><div class="menu-backdrop" data-menu-close></div><div class="menu-panel" id="public-menu-panel"><nav aria-label="Website menu"><a href="/#home">Home</a><a href="/Home/About">About</a><a href="/Home/Services">Services</a><a href="/Home/Gallery">Gallery</a><a href="/Home/Contact">Contact</a><a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Create", "Bookings")">Book Now</a></nav><div class="menu-actions"><a class="menu-login" asp-controller="Account" asp-action="Login">Log in</a><a class="menu-cta" asp-controller="Account" asp-action="Register">Sign up</a></div></div></div><nav class="guest-actions" aria-label="Account"><a class="guest-login" asp-controller="Account" asp-action="Login">Log in</a><a class="guest-signup" asp-controller="Account" asp-action="Register">Sign up</a></nav> }</header>
    <main>
    @if (!Context.Items.ContainsKey("InformationOnly")) { <link rel="stylesheet" href="~/css/account-settings.css" asp-append-version="true" /> }
    <link rel="stylesheet" href="~/css/flexible-booking.css" asp-append-version="true" />
    @if (TempData["Error"] != null) { <div class="alert error" role="alert">@TempData["Error"]</div> }
    @if (TempData["Success"] != null) { <div class="alert success" role="status">@TempData["Success"]</div> }
    @RenderBody()
    @if (staff && !DataStore.IsPersistent) { <details class="environment-info"><summary>Local testing information</summary><p>This is a local test environment. Bookings and payment records reset when the application stops. Payment verification is simulated and does not verify or transfer real money. Locally configured website content, gallery, catalog and seeded profile pictures may persist on this computer.</p></details> }
    @if (!staff) { <partial name="_PublicFooter" /> } else { <footer><span>© @DataStore.Now.Year Glam by Mariya</span><span>Thoughtfully made. Beautifully you. ✧</span></footer> }
    </main>
</div>
@if (!Context.Items.ContainsKey("InformationOnly")) {
<script src="~/js/booking-quantity.js" asp-append-version="true"></script>
<script src="~/js/availability-response.js" asp-append-version="true"></script>
}
<script src="~/js/mobile-menu.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/interaction-polish.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
