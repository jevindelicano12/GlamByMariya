@model List<CatalogItem>
@{ ViewData["Title"] = "Home-Service Makeup"; var authenticated = User.Identity?.IsAuthenticated == true; var content = ViewData["PublishedWebsiteContent"] as GlamByMariya.Core.BusinessRules.WebsiteTextInput; var images = ViewData["PublishedWebsiteImages"] as IReadOnlyList<GlamByMariya.Infrastructure.Services.WebsiteImageReference> ?? []; var hero = images.FirstOrDefault(x => x.Role == "hero" && x.Visible); var portrait = images.FirstOrDefault(x => x.Role == "portrait" && x.Visible); }
<section class="public-hero@(hero == null ? " no-photo" : "")" id="home" aria-labelledby="hero-title">
    <div class="public-hero-copy">
        <div class="eyebrow">HOME-SERVICE MAKEUP</div>
        <h1 id="hero-title">@if (!string.IsNullOrWhiteSpace(content?.HeroHeadline)) { @content.HeroHeadline } else { <text>Beauty that<br />comes to you.</text> }</h1>
        <p>@(string.IsNullOrWhiteSpace(content?.HeroDescription) ? "Glam by Mariya brings home-service makeup to your chosen location for your special moments." : content.HeroDescription)</p>
        <div class="public-buttons">
            @if (Context.Items.ContainsKey("InformationOnly")) { <a class="public-button" asp-controller="Home" asp-action="Contact">Contact</a> }
            else if (GlamByMariya.Core.Entities.Roles.IsStaff(User)) { <a class="public-button" asp-controller="Admin" asp-action="Index">Open workspace</a> } else if (authenticated) { <a class="public-button" asp-controller="Bookings" asp-action="Create">Book Now</a> }
            else { <a class="public-button" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Url.Action("Create", "Bookings")">Book Now</a> }
            <a class="public-button outline" href="#makeup-services">View Services</a>
        </div>
        <div class="public-benefits"><span><b aria-hidden="true">⌂</b> Home-Service<br />Only</span><span><b aria-hidden="true">▦</b> @if (Context.Items.ContainsKey("InformationOnly")) { <text>Contact for<br />Details</text> } else { <text>Book Your<br />Schedule</text> }</span><span><b aria-hidden="true">✧</b> Event-Ready<br />Looks</span></div>
    </div>
    <div class="photo-placeholder hero-placeholder">@if (hero != null) { <img src="@Url.Action("Image", "WebsiteImages", new { id = hero.Id })" alt="@hero.AltText" loading="eager" fetchpriority="high" decoding="async" /> } else { var featured = Model.Take(3).ToList(); <div class="hero-brand-card"><span class="hero-monogram" aria-hidden="true">G</span><strong>Glam by Mariya</strong><small>Home-service makeup</small>@if (featured.Count > 0) { <ul class="hero-service-list" aria-label="Featured services">@foreach (var item in featured) { <li><span>@item.Name</span><b>₱@item.Price.ToString("N0")</b></li> }</ul> }</div> }</div>
</section>
<section class="public-about@(portrait == null ? " no-photo" : "")" id="about" aria-labelledby="about-title">
    @if (portrait != null) { <div class="photo-placeholder portrait-placeholder"><img src="@Url.Action("Image", "WebsiteImages", new { id = portrait.Id })" alt="@portrait.AltText" loading="lazy" decoding="async" /></div> }
    <div><div class="eyebrow">ABOUT THE ARTIST</div><h2 id="about-title">@(string.IsNullOrWhiteSpace(content?.AboutHeading) ? "Meet Mariya" : content.AboutHeading)</h2><p>@(string.IsNullOrWhiteSpace(content?.AboutBiography) ? "Glam by Mariya offers makeup services at your chosen location. One makeup artist travels to you for your appointment." : content.AboutBiography)</p><a class="public-button" asp-controller="Home" asp-action="About">Learn More</a></div>
</section>
<section class="public-section" id="makeup-services" aria-labelledby="services-title">
    <div class="eyebrow">MAKEUP SERVICES</div><h2 id="services-title">Services</h2>
    <partial name="_PublicServices" model="Model" />
</section>
@if (images.Any(x => x.Role == "gallery" && x.Visible)) { <section class="public-section" id="gallery" aria-labelledby="gallery-title"><div class="eyebrow">PORTFOLIO</div><h2 id="gallery-title">Gallery</h2><partial name="_PublishedGallery" model="images" /></section> }
<section class="public-section public-contact" id="contact" aria-labelledby="contact-title"><div><div class="eyebrow">HOME-SERVICE MAKEUP</div><h2 id="contact-title">Contact</h2>@if (!string.IsNullOrWhiteSpace(content?.ContactDetails)) { <p class="contact-details">@content.ContactDetails</p> } else if (Context.Items.ContainsKey("InformationOnly")) { <p>Public contact details will be available once provided by the owner.</p> } else { var areas = (DataStore.Settings.ServiceAreas ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries); <dl class="contact-facts">@if (areas.Length > 0) { <div><dt>Service areas</dt><dd>@string.Join(" · ", areas)</dd></div> }<div><dt>Service hours</dt><dd>@DateTime.Today.AddHours(DataStore.Settings.OpenHour).ToString("h tt") – @DateTime.Today.AddHours(DataStore.Settings.CloseHour).ToString("h tt")</dd></div></dl> }</div><div><h3>Makeup at your location</h3><p>@(string.IsNullOrWhiteSpace(content?.HomeServiceDescription) ? "One makeup artist travels to your chosen location for your appointment." : content.HomeServiceDescription)</p>@if (Context.Items.ContainsKey("InformationOnly")) { <a class="public-button" asp-controller="Home" asp-action="Contact">Contact</a> } else if (GlamByMariya.Core.Entities.Roles.IsStaff(User)) { <a class="public-button" asp-controller="Admin" asp-action="Index">Open workspace</a> } else if (authenticated) { <a class="public-button" asp-controller="Bookings" asp-action="Create">Book Now</a> } else { <a class="public-button" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Url.Action("Create", "Bookings")">Book Now</a> }</div></section>
@{ var faqs = (content?.Faqs ?? []).Where(x => !string.IsNullOrWhiteSpace(x.Question) && !string.IsNullOrWhiteSpace(x.Answer)).Take(15).ToList(); }
@if (faqs.Count > 0) { <section class="public-section public-faq" aria-labelledby="faq-title"><div class="eyebrow">HELPFUL DETAILS</div><h2 id="faq-title">Frequently asked questions</h2><div class="faq-list">@foreach (var faq in faqs) { <details class="faq-item"><summary>@faq.Question</summary><p>@faq.Answer</p></details> }</div></section> }
