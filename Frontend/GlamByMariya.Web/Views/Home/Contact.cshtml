@{ ViewData["Title"] = "Contact"; var content = ViewData["PublishedWebsiteContent"] as GlamByMariya.Core.BusinessRules.WebsiteTextInput; }
<div class="public-page"><h1>Contact</h1><p class="public-breadcrumb"><a asp-action="Index">Home</a> / Contact</p><section class="public-contact"><div><h2>Get in Touch</h2>@if (!string.IsNullOrWhiteSpace(content?.ContactDetails)) { <p class="contact-details">@content.ContactDetails</p> } else if (Context.Items.ContainsKey("InformationOnly")) { <p>Public contact details will be available once provided by the owner.</p> } else { var areas = (DataStore.Settings.ServiceAreas ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries); <dl class="contact-facts">@if (areas.Length > 0) { <div><dt>Service areas</dt><dd>@string.Join(" · ", areas)</dd></div> }<div><dt>Service hours</dt><dd>@DateTime.Today.AddHours(DataStore.Settings.OpenHour).ToString("h tt") – @DateTime.Today.AddHours(DataStore.Settings.CloseHour).ToString("h tt")</dd></div></dl> }<partial name="_PublishedSocialLinks" model="content?.Links" /></div><div><h2>Makeup at your location</h2><p>@(string.IsNullOrWhiteSpace(content?.HomeServiceDescription) ? "One makeup artist travels to your chosen location for your appointment." : content.HomeServiceDescription)</p>@if (!string.IsNullOrWhiteSpace(content?.ServiceAreaInformation)) { <p>@content.ServiceAreaInformation</p> }@if (!Context.Items.ContainsKey("InformationOnly")) { if (GlamByMariya.Core.Entities.Roles.IsStaff(User)) { <a class="public-button" asp-controller="Admin" asp-action="Index">Open workspace</a> } else if (User.Identity?.IsAuthenticated == true) { <a class="public-button" asp-controller="Bookings" asp-action="Create">Book Now</a> } else { <a class="public-button" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Url.Action("Create", "Bookings")">Book Now</a> } }</div></section></div>
