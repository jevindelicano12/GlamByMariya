@{ ViewData["Title"] = "Contact"; var content = ViewData["PublishedWebsiteContent"] as GlamByMariya.Core.BusinessRules.WebsiteTextInput; }
<div class="public-page"><h1>Contact</h1><p class="public-breadcrumb"><a asp-action="Index">Home</a> / Contact</p><section class="public-contact"><div><h2>Get in Touch</h2><p>@(string.IsNullOrWhiteSpace(content?.ContactDetails) ? "Public contact details will be available once provided by the owner." : content.ContactDetails)</p><partial name="_PublishedSocialLinks" model="content?.Links" /></div><div><h2>Makeup at your location</h2><p>@(string.IsNullOrWhiteSpace(content?.HomeServiceDescription) ? "One makeup artist travels to your chosen location for your appointment." : content.HomeServiceDescription)</p>@if (!string.IsNullOrWhiteSpace(content?.ServiceAreaInformation)) { <p>@content.ServiceAreaInformation</p> }@if (!Context.Items.ContainsKey("InformationOnly")) { if (User.Identity?.IsAuthenticated == true) { <a class="public-button" asp-controller="Bookings" asp-action="Create">Book Now</a> } else { <a class="public-button" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@Url.Action("Create", "Bookings")">Book Now</a> } }</div></section></div>
