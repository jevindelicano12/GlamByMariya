@{ ViewData["Title"] = "About"; var content = ViewData["PublishedWebsiteContent"] as GlamByMariya.Core.BusinessRules.WebsiteTextInput; var images = ViewData["PublishedWebsiteImages"] as IReadOnlyList<GlamByMariya.Infrastructure.Services.WebsiteImageReference> ?? []; var portrait = images.FirstOrDefault(x => x.Role == "portrait" && x.Visible); }
<div class="public-page"><h1>About</h1><p class="public-breadcrumb"><a asp-action="Index">Home</a> / About</p>
<section class="public-about public-page-about@(portrait == null ? " no-photo" : "")">@if (portrait != null) { <div class="photo-placeholder portrait-placeholder"><img src="@Url.Action("Image", "WebsiteImages", new { id = portrait.Id })" alt="@portrait.AltText" /></div> }<div><h2>@(string.IsNullOrWhiteSpace(content?.AboutHeading) ? "About Glam by Mariya" : content.AboutHeading)</h2><p>@(string.IsNullOrWhiteSpace(content?.AboutBiography) ? "Glam by Mariya offers makeup services at your chosen location. One makeup artist travels to you for your appointment." : content.AboutBiography)</p></div></section>
<div class="public-about-benefits"><span>⌂<br />Home-service makeup</span><span>♡<br />Personalized looks</span><span>▦<br />By appointment</span></div></div>
