# REFERENCE ONLY. Do not import into the public-only service or populate in source.
# Each blank below is a placeholder for a NEW V2 value in a secret manager.
# Setting these values does NOT enable or approve the unfinished booking host.

Authentication__DurableSessionEnforcement=false
Email__DeliveryDisabled=true

# PostgreSQL: choose this connection string OR the component fields, not both.
ConnectionStrings__MakeupDatabase=
Database__Provider=PostgreSql
Database__Schema=public
Database__ProjectId=
Database__Host=
Database__Port=5432
Database__Name=postgres
Database__Username=
Database__Password=
Database__RootCertificate=/app/App_Data/Certificates/supabase-prod-ca-2021.crt
Database__MaxPoolSize=4

# Supabase Auth: V2 project URL and public anon key, never a service-role key here.
Supabase__Url=
Supabase__AnonKey=

# Storage: future private bucket adapter (current code fixes bucket to app-files).
# No bucket provisioning or production proof-state integration is implemented.
FileStorage__Provider=Supabase
SupabaseStorage__ServiceKey=

# New Brevo transactional configuration: API HTTPS, not SMTP.
# Placeholder sender only: replace with the NEW verified sender after approval.
Email__BrevoApiKey=
Email__From=verified-sender@example.invalid

# Future public-schema cookie protection: independently generated V2 certificate.
DataProtection__CertificatePfxBase64=
DataProtection__CertificatePassword=

# Deployment-specific proxy IPs, only after Render trust boundaries are verified.
ForwardedHeaders__KnownProxies=
AllowedHosts=
